{
  "description": "Measure nodes: a noisy sphere coloured by mean curvature (dark creases, bright bulges), a rock on the ground coloured by ambient occlusion (the ground is its occluder, so the contact darkens), and a ground grid coloured by its distance to a path curve. An assert on the final merge guards the layout: four pieces, colours in 0..1, everything inside the stage box, no flipped normals.",
  "vars": { "path_width": 0.35 },
  "nodes": {
    "ball": { "type": "sphere", "params": { "type": "ico", "level": 5, "radius": 1, "center": [-3.2, 1.1, 0] } },
    "ball_noise": { "type": "noise_displace", "in": ["ball"], "params": { "amplitude": 0.22, "frequency": 2.2, "octaves": 3 } },
    "ball_k": { "type": "curvature", "in": ["ball_noise"], "params": { "type": "mean", "smooth_iterations": 2, "normalize": true, "clip_percent": 3 } },
    "ball_col": {
      "type": "color",
      "in": ["ball_k"],
      "params": { "mode": "ramp", "attrib": "curvature", "range": [0, 1], "ramp": [[0, "#2b1d3a"], [0.45, "#8f5e9e"], [0.75, "#e8b4c8"], [1, "#fff4e0"]] }
    },

    "ground": { "type": "grid", "params": { "size": [11, 6], "divisions": [110, 60] } },
    "rock": { "type": "sphere", "params": { "type": "ico", "level": 5, "radius": 0.9, "scale": [1.3, 0.75, 1], "center": [0.2, 0.45, 0.3] } },
    "rock_shape": { "type": "noise_displace", "in": ["rock"], "params": { "amplitude": 0.32, "frequency": 1.5, "octaves": 4, "seed": 3 } },
    "rock_ao": { "type": "occlusion", "in": ["rock_shape", "ground"], "params": { "samples": 48, "max_distance": 2 } },
    "rock_col": {
      "type": "color",
      "in": ["rock_ao"],
      "params": { "mode": "ramp", "attrib": "ao", "range": [0, 0.5], "ramp": [[0, "#eee8dc"], [0.4, "#a8a092"], [1, "#2a2622"]] }
    },

    "path": { "type": "curve", "params": { "points": [[-5.4, 0, 2.6], [-2.5, 0, 1.8], [-0.8, 0, -1.8], [2.2, 0, -1.5], [3.6, 0, 1.2], [5.4, 0, 2.2]], "smooth": true } },
    "ground_d": { "type": "distance", "in": ["ground", "path"] },
    "ground_col": {
      "type": "color",
      "in": ["ground_d"],
      "params": { "mode": "ramp", "attrib": "dist", "range": [0, 2.5], "ramp": [[0, "#d8c193"], ["=path_width / 2.5", "#c9ad7c"], ["=path_width / 2.5 + 0.02", "#6f9a45"], [1, "#2d5a27"]] }
    },
    "path_line": { "type": "transform", "in": ["path"], "params": { "translate": [0, 0.02, 0] } },
    "path_col": { "type": "color", "in": ["path_line"], "params": { "color": "#b5541d" } },

    "out": { "type": "merge", "in": ["ground_col", "path_col", "ball_col", "rock_col"] },
    "check": {
      "type": "assert",
      "in": ["out"],
      "params": {
        "label": "measures showcase",
        "no_flipped": true,
        "attrib": "Cd",
        "attrib_min": 0,
        "attrib_max": 1,
        "bbox_min": [-5.6, -1, -3.1],
        "bbox_max": [5.6, 2.5, 3.1],
        "expr": "pieces == 4 && npolys > 30000 && nlines == 1"
      }
    }
  },
  "output": "check"
}
