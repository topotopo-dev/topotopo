{
  "description": "Remesh, repair, LOD. Left: a noise-displaced sphere remeshed isotropically with an adaptive target length (target_attrib from the distance to a point above it: small triangles at the top, large at the bottom), faces in random greys so the triangles show. Middle: an extruded text broken on purpose (faces flipped, a cap deleted, a duplicate face added: the blue back faces show the damage) and the same text after mesh_repair (winding fixed, hole filled in orange, duplicates removed). Right: an L-system tree reduced to four levels of detail with lod (1, 0.4, 0.15, 0.05 of the triangles; leaves are pruned in the coarse levels), laid out side by side with spacing and coloured per level.",
  "meta": { "render": { "views": ["front", "persp"], "azimuth": 25, "elevation": 18 } },
  "nodes": {
    "ball": { "type": "sphere", "params": { "type": "ico", "level": 4, "center": [-2.6, 1.05, 0] } },
    "bumpy": { "type": "noise_displace", "in": ["ball"], "params": { "amplitude": 0.15, "frequency": 1.5 } },
    "size": {
      "type": "wrangle",
      "in": ["bumpy"],
      "params": { "code": "f@tl = fit(length(sub(@P, set(-2.6, 2.05, 0))), 0, 2, 0.06, 0.3);" }
    },
    "iso": {
      "type": "remesh_isotropic",
      "in": ["size"],
      "params": { "target_attrib": "tl", "iterations": 8 }
    },
    "iso_col": {
      "type": "color",
      "in": ["iso"],
      "params": { "class": "prim", "mode": "random", "saturation": [0, 0.12], "value": [0.45, 1] }
    },
    "word": { "type": "text", "params": { "text": "FIX", "size": 1, "depth": 0.3 } },
    "word_place": { "type": "transform", "in": ["word"], "params": { "translate": [-0.6, 1.2, 0] } },
    "flip_some": { "type": "reverse", "in": ["word_place"], "params": { "group": "9 13 16 40-42 82 85 0-40:5" } },
    "hole": { "type": "delete", "in": ["flip_some"], "params": { "group": "45" } },
    "dup_face": { "type": "delete", "in": ["word_place"], "params": { "group": "61", "keep": true } },
    "broken": { "type": "merge", "in": ["hole", "dup_face"] },
    "broken_col": { "type": "color", "in": ["broken"], "params": { "class": "prim", "color": "#9fb4c7" } },
    "fixed_src": { "type": "transform", "in": ["broken"], "params": { "translate": [0, -1.2, 0] } },
    "fixed": { "type": "mesh_repair", "in": ["fixed_src"], "params": { "max_hole_edges": 0 } },
    "fixed_col": { "type": "color", "in": ["fixed"], "params": { "class": "prim", "color": "#7fc48a" } },
    "fill_col": {
      "type": "color",
      "in": ["fixed_col"],
      "params": { "class": "prim", "color": "#f28c38", "group": "filled" }
    },
    "ls": {
      "type": "lsystem",
      "params": {
        "axiom": "FFA",
        "rules": { "A": [["F[&+A!J][&-A!J][^A!J]F", 0.6], ["F[&+A!J][^-A!J]A", 0.4]] },
        "generations": 5,
        "angle": 32,
        "step": 0.35,
        "width": 0.16,
        "width_scale": 0.72,
        "branch_scale": 0.82,
        "angle_variance": 10,
        "tropism": [0, -1, 0],
        "tropism_strength": 0.08,
        "seed": 3
      }
    },
    "wood": { "type": "polywire", "in": ["ls"], "params": { "divisions": 8 } },
    "bark": { "type": "color", "in": ["wood"], "params": { "color": "#6b4a2f" } },
    "leafpts": { "type": "delete", "in": ["ls"], "params": { "class": "point", "group": "leaves", "keep": true } },
    "leafsize": {
      "type": "attrib_randomize",
      "in": ["leafpts"],
      "params": { "name": "pscale", "min": 0.25, "max": 0.4 }
    },
    "leaf": { "type": "shape2d", "params": { "shape": "ngon", "sides": 6, "radius": 0.5, "plane": "xy" } },
    "leafshape": {
      "type": "transform",
      "in": ["leaf"],
      "params": { "scale": [0.55, 1, 1], "translate": [0, 0, 0.3], "rotate": [90, 0, 0] }
    },
    "leaves": { "type": "copy_to_points", "in": ["leafshape", "leafsize"] },
    "leafcol": { "type": "color", "in": ["leaves"], "params": { "color": "#5f9e3a" } },
    "tree": { "type": "merge", "in": ["bark", "leafcol"] },
    "tree_place": { "type": "transform", "in": ["tree"], "params": { "translate": [-3.3, 2.4, 0] } },
    "lods": {
      "type": "lod",
      "in": ["tree_place"],
      "params": { "levels": 4, "ratios": [1, 0.4, 0.15, 0.05], "spacing": [2.2, 0, 0], "base_name": "tree" }
    },
    "lod_tint": {
      "type": "wrangle",
      "in": ["lods"],
      "params": {
        "run_over": "prims",
        "code": "const t = [[1, 1, 1], [0.85, 0.95, 1.15], [1.15, 0.95, 0.8], [1.2, 0.8, 1.1]][i@lod];\n@Cd = set(@Cd.x * t[0], @Cd.y * t[1], @Cd.z * t[2]);"
      }
    },
    "out": { "type": "merge", "in": ["iso_col", "broken_col", "fill_col", "lod_tint"] }
  },
  "output": "out"
}
