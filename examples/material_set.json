{
  "version": 1,
  "description": "Three tileable game materials made only from texture nodes, each with colour, normal and ORM (occlusion, roughness, metallic) maps at the chosen resolution. Stone: a bricks pattern warped by noise into rough blocks, chiselled with crystal facets and grain, edges chipped where the relief is convex (more with wear), grime in the hollows (more with dirt). Wood: planks whose grain is a ring curve of a per-plank gradient bent by stretched fibre noise and knots, worn along the plank edges. Metal: plates and rivets from patterns, paint chipped off the convex edges down to brushed steel, rust running down from the rivets (a one-sided directional blur at a quarter of the resolution, broken by stretched noise) laid over in its own colours. Grey values go through a gradient map for colour; occlusion and grime come from a blurred-height cavity. Low-frequency noise is made at a quarter of the resolution and stretched by the blends, which keeps the cook light. Pattern distances are fractions of a tile; relief depths are real metres on a tile of tile_size metres, so the normal maps hold true at that size. The swatches are 2 m tiles uv-mapped at tile_size metres per tile, image top at the far edge, each given its material through the material node.",
  "params": {
    "resolution": {"type": "enum", "options": [256, 512, 1024], "default": 512, "label": "resolution", "desc": "pixels along each side of every map"},
    "tile_size": {"type": "float", "default": 1, "min": 0.5, "max": 4, "step": 0.25, "label": "tile size", "desc": "metres one tile of each material covers on a model"},
    "wear": {"type": "float", "default": 0.4, "min": 0, "max": 1, "step": 0.05, "label": "wear", "desc": "how worn the edges and the paint are"},
    "dirt": {"type": "float", "default": 0.3, "min": 0, "max": 1, "step": 0.05, "label": "dirt", "desc": "dirt and grime in the cracks"},
    "seed": {"type": "int", "default": 1, "min": 0, "max": 9999, "label": "seed", "desc": "changes the patterns, not the materials"}
  },
  "vars": {"resolution": 512, "tile_size": 1, "wear": 0.4, "dirt": 0.3, "seed": 1},
  "meta": {"render": {"views": ["persp"], "azimuth": 0, "elevation": 62, "size": "1600x620", "shading": "pbr", "textures": true, "grid": false, "view_labels": false}},
  "nodes": {
    "stone_blocks": {"type": "tex_pattern", "params": {"resolution": "=resolution", "texture_size": "=tile_size", "pattern": "bricks", "count": [2, 4], "gap": 0.07, "bevel": 0.1, "seed": "=seed"}},
    "stone_wobble": {"type": "tex_noise", "params": {"resolution": "=resolution / 4", "texture_size": "=tile_size", "feature": 0.25, "octaves": 5, "roughness": 0.55, "seed": "=seed + 11"}},
    "stone_shape": {"type": "tex_warp", "in": ["stone_blocks", "stone_wobble"], "params": {"mode": "slope", "intensity": 0.012}},
    "stone_ids": {"type": "tex_output", "in": ["stone_blocks"], "params": {"layer": "id", "keep_only": true}},
    "stone_grain": {"type": "tex_noise", "params": {"resolution": "=resolution", "texture_size": "=tile_size", "feature": 0.125, "octaves": 6, "roughness": 0.6, "seed": "=seed + 5"}},
    "stone_facets": {"type": "tex_cells", "params": {"resolution": "=resolution / 4", "texture_size": "=tile_size", "output": "crystal", "cell": 0.1111, "seed": "=seed + 7"}},
    "stone_bumpy": {"type": "tex_blend", "in": ["stone_shape", "stone_grain"], "params": {"mode": "add", "opacity": 0.3, "clamp": false}},
    "stone_faceted": {"type": "tex_blend", "in": ["stone_bumpy", "stone_facets"], "params": {"mode": "add", "opacity": 0.25, "clamp": false}},
    "stone_soft": {"type": "tex_blur", "in": ["stone_faceted"], "params": {"blur": 0.0234}},
    "stone_cavity": {"type": "tex_blend", "in": ["stone_soft", "stone_faceted"], "params": {"mode": "subtract"}},
    "stone_convex": {"type": "tex_blend", "in": ["stone_faceted", "stone_soft"], "params": {"mode": "subtract"}},
    "stone_rim": {"type": "tex_levels", "in": ["stone_convex"], "params": {"in_high": 0.1}},
    "stone_chip_noise": {"type": "tex_noise", "params": {"resolution": "=resolution / 4", "texture_size": "=tile_size", "feature": 0.08333, "octaves": 5, "seed": "=seed + 17"}},
    "stone_chip_spots": {"type": "tex_histogram_scan", "in": ["stone_chip_noise"], "params": {"coverage": "=0.45 * wear", "contrast": 0.9}},
    "stone_chips": {"type": "tex_blend", "in": ["stone_rim", "stone_chip_spots"], "params": {"mode": "multiply"}},
    "stone_height": {"type": "tex_blend", "in": ["stone_faceted", "stone_chips"], "params": {"mode": "subtract", "opacity": 0.45, "clamp": false}},
    "stone_normal": {"type": "tex_normal_from_height", "in": ["stone_height"], "params": {"depth": 0.03}},
    "stone_ao": {"type": "tex_levels", "in": ["stone_cavity"], "params": {"in_high": 0.35, "out_low": 1, "out_high": 0.3}},
    "stone_dirt_noise": {"type": "tex_noise", "params": {"resolution": "=resolution / 4", "texture_size": "=tile_size", "feature": 0.2, "octaves": 5, "seed": "=seed + 19"}},
    "stone_grime": {"type": "tex_levels", "in": ["stone_cavity"], "params": {"in_high": "=0.3 - 0.22 * dirt", "out_low": 1, "out_high": "=0.75 - 0.45 * dirt"}},
    "stone_face": {"type": "tex_blend", "in": ["stone_grain", "stone_ids"], "params": {"mode": "normal", "opacity": 0.35}},
    "stone_laid": {"type": "tex_blend", "in": ["stone_face", "stone_shape"], "params": {"mode": "multiply"}},
    "stone_chipped": {"type": "tex_blend", "in": ["stone_laid", "stone_chips"], "params": {"mode": "add", "opacity": 0.15}},
    "stone_grimy": {"type": "tex_blend", "in": ["stone_chipped", "stone_grime", "stone_dirt_noise"], "params": {"mode": "multiply"}},
    "stone_color": {"type": "tex_colorize", "in": ["stone_grimy"], "params": {"ramp": [[0, "#2b2723"], [0.1, "#47423c"], [0.2, "#5b5b58"], [0.4, "#73726c"], [0.6, "#8c877d"], [0.85, "#aca596"], [1, "#bdb5a5"]]}},
    "stone_rough": {"type": "tex_levels", "in": ["stone_height"], "params": {"out_low": 0.95, "out_high": 0.72}},
    "stone_orm": {"type": "tex_channel", "in": ["stone_ao", "stone_rough"], "params": {"fill": [1, 0.5, 0, 1]}},
    "stone_maps": {"type": "merge", "in": ["stone_color", "stone_normal", "stone_orm"]},
    "stone_material": {"type": "texture_to_material", "in": [null, "stone_maps"], "params": {"material": "stone", "base_color": "stone_color", "normal": "stone_normal", "orm": "stone_orm"}},
    "stone": {"type": "assert", "in": ["stone_material"], "params": {"label": "maps", "images": "stone_color stone_normal stone_orm", "image_size": "=resolution", "image_min": 0, "image_max": 1}},

    "wood_planks": {"type": "tex_pattern", "params": {"resolution": "=resolution", "texture_size": "=tile_size", "pattern": "bricks", "count": [1, 6], "gap": 0.045, "bevel": 0.07, "seed": "=seed + 31"}},
    "wood_ids": {"type": "tex_output", "in": ["wood_planks"], "params": {"layer": "id", "keep_only": true}},
    "wood_across": {"type": "tex_gradient", "params": {"resolution": "=[resolution / 16, resolution]", "texture_size": "=tile_size", "angle": 90}},
    "wood_saw": {"type": "tex_transform", "in": ["wood_across"], "params": {"tile": [1, 6]}},
    "wood_fibre": {"type": "tex_noise", "params": {"resolution": "=[resolution / 8, resolution]", "texture_size": "=tile_size", "feature": 1, "octaves": 3, "roughness": 0.5, "seed": "=seed + 37"}},
    "wood_knot_cells": {"type": "tex_cells", "params": {"resolution": "=[resolution / 4, resolution / 2]", "texture_size": "=tile_size", "output": "distance", "cell": 0.5, "jitter": 0.8, "seed": "=seed + 41"}},
    "wood_knot_ids": {"type": "tex_output", "in": ["wood_knot_cells"], "params": {"layer": "id", "keep_only": true}},
    "wood_knot_pick": {"type": "tex_threshold", "in": ["wood_knot_ids"], "params": {"threshold": 0.68}},
    "wood_knot_dome": {"type": "tex_levels", "in": ["wood_knot_cells"], "params": {"in_high": 0.2, "gamma": 0.7, "out_low": 1, "out_high": 0}},
    "wood_knots": {"type": "tex_blend", "in": ["wood_knot_dome", "wood_knot_pick"], "params": {"mode": "multiply"}},
    "wood_phase": {"type": "tex_blend", "in": ["wood_ids", "wood_saw"], "params": {"mode": "normal", "opacity": 0.55}},
    "wood_wavy": {"type": "tex_blend", "in": ["wood_phase", "wood_fibre"], "params": {"mode": "overlay", "opacity": 0.9}},
    "wood_bent": {"type": "tex_blend", "in": ["wood_wavy", "wood_knots"], "params": {"mode": "add", "opacity": 0.22}},
    "wood_rings": {"type": "tex_curves", "in": ["wood_bent"], "params": {"ramp": [[0, 0], [0.072, 0.15], [0.088, 1.0], [0.1, 0.0], [0.172, 0.15], [0.188, 1.0], [0.2, 0.0], [0.272, 0.15], [0.288, 1.0], [0.3, 0.0], [0.372, 0.15], [0.388, 1.0], [0.4, 0.0], [0.472, 0.15], [0.488, 1.0], [0.5, 0.0], [0.572, 0.15], [0.588, 1.0], [0.6, 0.0], [0.672, 0.15], [0.688, 1.0], [0.7, 0.0], [0.772, 0.15], [0.788, 1.0], [0.8, 0.0], [0.872, 0.15], [0.888, 1.0], [0.9, 0.0], [0.972, 0.15], [0.988, 1.0], [1.0, 0.0]]}},
    "wood_relief": {"type": "tex_blend", "in": ["wood_planks", "wood_rings"], "params": {"mode": "add", "opacity": 0.06, "clamp": false}},
    "wood_soft": {"type": "tex_blur", "in": ["wood_relief"], "params": {"blur": 0.0156}},
    "wood_cavity": {"type": "tex_blend", "in": ["wood_soft", "wood_relief"], "params": {"mode": "subtract"}},
    "wood_rim": {"type": "tex_histogram_select", "in": ["wood_planks"], "params": {"position": 0.55, "range": 0.8, "contrast": 0.6}},
    "wood_scuffs": {"type": "tex_threshold", "in": ["wood_fibre"], "params": {"threshold": "=0.75 - 0.3 * wear", "softness": 0.08}},
    "wood_wear": {"type": "tex_blend", "in": ["wood_rim", "wood_scuffs"], "params": {"mode": "multiply", "opacity": "=min(1, 3 * wear)"}},
    "wood_height": {"type": "tex_blend", "in": ["wood_relief", "wood_wear"], "params": {"mode": "subtract", "opacity": 0.25, "clamp": false}},
    "wood_normal": {"type": "tex_normal_from_height", "in": ["wood_height"], "params": {"depth": 0.008}},
    "wood_ao": {"type": "tex_levels", "in": ["wood_cavity"], "params": {"in_high": 0.3, "out_low": 1, "out_high": 0.35}},
    "wood_grime": {"type": "tex_levels", "in": ["wood_cavity"], "params": {"in_high": "=0.3 - 0.24 * dirt", "out_low": 1, "out_high": "=0.7 - 0.4 * dirt"}},
    "wood_value": {"type": "tex_blend", "in": ["wood_ids", "wood_fibre"], "params": {"mode": "normal", "opacity": 0.6}},
    "wood_lines": {"type": "tex_blend", "in": ["wood_value", "wood_rings"], "params": {"mode": "subtract", "opacity": 0.3}},
    "wood_knotted": {"type": "tex_blend", "in": ["wood_lines", "wood_knots"], "params": {"mode": "subtract", "opacity": 0.45}},
    "wood_laid": {"type": "tex_blend", "in": ["wood_knotted", "wood_planks"], "params": {"mode": "multiply"}},
    "wood_worn": {"type": "tex_blend", "in": ["wood_laid", "wood_wear"], "params": {"mode": "add", "opacity": 0.25}},
    "wood_grimy": {"type": "tex_blend", "in": ["wood_worn", "wood_grime"], "params": {"mode": "multiply"}},
    "wood_color": {"type": "tex_colorize", "in": ["wood_grimy"], "params": {"ramp": [[0, "#1e1009"], [0.15, "#3f2311"], [0.35, "#6e421f"], [0.55, "#99632f"], [0.8, "#bf8b52"], [1, "#d6aa72"]]}},
    "wood_rough_base": {"type": "tex_levels", "in": ["wood_height"], "params": {"out_low": 0.9, "out_high": 0.5}},
    "wood_rough": {"type": "tex_blend", "in": ["wood_rough_base", "wood_wear"], "params": {"mode": "add", "opacity": 0.3}},
    "wood_orm": {"type": "tex_channel", "in": ["wood_ao", "wood_rough"], "params": {"fill": [1, 0.5, 0, 1]}},
    "wood_maps": {"type": "merge", "in": ["wood_color", "wood_normal", "wood_orm"]},
    "wood_material": {"type": "texture_to_material", "in": [null, "wood_maps"], "params": {"material": "wood", "base_color": "wood_color", "normal": "wood_normal", "orm": "wood_orm"}},
    "wood": {"type": "assert", "in": ["wood_material"], "params": {"label": "maps", "images": "wood_color wood_normal wood_orm", "image_size": "=resolution", "image_min": 0, "image_max": 1}},

    "metal_plates": {"type": "tex_pattern", "params": {"resolution": "=resolution", "texture_size": "=tile_size", "pattern": "tiles", "count": [2, 2], "gap": 0.025, "bevel": 0.05}},
    "metal_inner": {"type": "tex_pattern", "params": {"resolution": "=resolution / 4", "texture_size": "=tile_size", "pattern": "tiles", "count": [2, 2], "gap": 0.64, "bevel": 0}},
    "metal_rivet_grid": {"type": "tex_shape", "params": {"resolution": "=resolution / 2", "texture_size": "=tile_size", "shape": "disc", "fill": 0.3, "falloff": 0.55, "tile": [6, 6]}},
    "metal_rivets": {"type": "tex_blend", "in": ["metal_rivet_grid", "metal_inner"], "params": {"mode": "subtract"}},
    "metal_dent_noise": {"type": "tex_noise", "params": {"resolution": "=resolution / 4", "texture_size": "=tile_size", "feature": 0.1667, "octaves": 5, "roughness": 0.55, "seed": "=seed + 59"}},
    "metal_riveted": {"type": "tex_blend", "in": ["metal_plates", "metal_rivets"], "params": {"mode": "add", "opacity": 0.5, "clamp": false}},
    "metal_relief": {"type": "tex_blend", "in": ["metal_riveted", "metal_dent_noise"], "params": {"mode": "add", "opacity": 0.08, "clamp": false}},
    "metal_soft": {"type": "tex_blur", "in": ["metal_relief"], "params": {"blur": 0.0117}},
    "metal_cavity": {"type": "tex_blend", "in": ["metal_soft", "metal_relief"], "params": {"mode": "subtract"}},
    "metal_convex": {"type": "tex_blend", "in": ["metal_relief", "metal_soft"], "params": {"mode": "subtract"}},
    "metal_rim": {"type": "tex_levels", "in": ["metal_convex"], "params": {"in_high": 0.08, "out_high": "=0.7 * wear"}},
    "metal_chip_noise": {"type": "tex_noise", "params": {"resolution": "=resolution / 4", "texture_size": "=tile_size", "feature": 0.07143, "octaves": 5, "roughness": 0.6, "seed": "=seed + 71"}},
    "metal_chip_field": {"type": "tex_blend", "in": ["metal_rim", "metal_chip_noise"], "params": {"mode": "add", "clamp": false}},
    "metal_chips": {"type": "tex_threshold", "in": ["metal_chip_field"], "params": {"threshold": "=0.85 - 0.15 * wear", "softness": 0.02}},
    "metal_height": {"type": "tex_blend", "in": ["metal_relief", "metal_chips"], "params": {"mode": "subtract", "opacity": 0.06, "clamp": false}},
    "metal_normal": {"type": "tex_normal_from_height", "in": ["metal_height"], "params": {"depth": 0.006}},
    "metal_brush": {"type": "tex_noise", "params": {"resolution": "=[resolution / 32, resolution]", "texture_size": "=tile_size", "feature": 0.3333, "octaves": 3, "seed": "=seed + 61"}},
    "metal_rivet_small": {"type": "tex_crop", "in": ["metal_rivets"], "params": {"resolution": "=[resolution / 4, resolution / 4]"}},
    "metal_rivet_soft": {"type": "tex_blur", "in": ["metal_rivet_small"], "params": {"blur": 0.0078}},
    "metal_trails": {"type": "tex_directional_blur", "in": ["metal_rivet_soft"], "params": {"length": "=0.1 * tile_size", "angle": -90, "symmetric": false}},
    "metal_leak_noise": {"type": "tex_noise", "params": {"resolution": "=[resolution / 4, resolution / 32]", "texture_size": "=tile_size", "feature": 0.025, "octaves": 3, "seed": "=seed + 67"}},
    "metal_leaks": {"type": "tex_blend", "in": ["metal_trails", "metal_leak_noise"], "params": {"mode": "multiply"}},
    "metal_rust": {"type": "tex_levels", "in": ["metal_leaks"], "params": {"in_low": 0.03, "in_high": "=0.32 - 0.2 * wear", "gamma": 0.8}},
    "metal_rust_heads": {"type": "tex_blend", "in": ["metal_rust", "metal_rivet_small"], "params": {"mode": "max", "opacity": "=0.3 + 0.5 * wear"}},
    "metal_paint": {"type": "tex_levels", "in": ["metal_relief"], "params": {"in_low": 1, "in_high": 1.08, "out_low": 0.1, "out_high": 0.34}},
    "metal_steel": {"type": "tex_levels", "in": ["metal_brush"], "params": {"out_low": 0.6, "out_high": 1}},
    "metal_bare": {"type": "tex_blend", "in": ["metal_paint", "metal_steel", "metal_chips"], "params": {"mode": "normal"}},
    "metal_tinted": {"type": "tex_colorize", "in": ["metal_bare"], "params": {"ramp": [[0, "#1b3250"], [0.2, "#2a5687"], [0.45, "#4479b0"], [0.55, "#55585c"], [0.8, "#8a8d91"], [1, "#b7babd"]]}},
    "metal_rust_color": {"type": "tex_colorize", "in": ["metal_leak_noise"], "params": {"ramp": [[0, "#5a2810"], [0.5, "#8e4a1e"], [1, "#c27434"]]}},
    "metal_rusty": {"type": "tex_blend", "in": ["metal_tinted", "metal_rust_color", "metal_rust_heads"], "params": {"mode": "normal", "opacity": 0.9}},
    "metal_grime": {"type": "tex_levels", "in": ["metal_cavity"], "params": {"in_high": "=0.25 - 0.2 * dirt", "out_low": 1, "out_high": "=0.6 - 0.35 * dirt"}},
    "metal_color": {"type": "tex_blend", "in": ["metal_rusty", "metal_grime"], "params": {"mode": "multiply"}},
    "metal_ao": {"type": "tex_levels", "in": ["metal_cavity"], "params": {"in_high": 0.25, "out_low": 1, "out_high": 0.4}},
    "metal_rough_bare": {"type": "tex_levels", "in": ["metal_bare"], "params": {"out_low": 0.82, "out_high": 0.25}},
    "metal_rough": {"type": "tex_blend", "in": ["metal_rough_bare", "metal_rust_heads"], "params": {"mode": "add", "opacity": 0.45}},
    "metal_metallic": {"type": "tex_blend", "in": ["metal_chips", "metal_rust_heads"], "params": {"mode": "subtract"}},
    "metal_orm": {"type": "tex_channel", "in": ["metal_ao", "metal_rough", "metal_metallic"]},
    "metal_maps": {"type": "merge", "in": ["metal_color", "metal_normal", "metal_orm"]},
    "metal_material": {"type": "texture_to_material", "in": [null, "metal_maps"], "params": {"material": "metal", "base_color": "metal_color", "normal": "metal_normal", "orm": "metal_orm"}},
    "metal": {"type": "assert", "in": ["metal_material"], "params": {"label": "maps", "images": "metal_color metal_normal metal_orm", "image_size": "=resolution", "image_min": 0, "image_max": 1}},

    "stone_tile": {"type": "box", "params": {"size": [2, 0.04, 2], "center": [0, 0.02, 0]}},
    "stone_tile_uv": {"type": "uv_project", "in": ["stone_tile"], "params": {"method": "box", "scale": ["=tile_size", "=tile_size"]}},
    "stone_tile_placed": {"type": "transform", "in": ["stone_tile_uv"], "params": {"rotate": [0, 180, 0], "translate": [-2.4, 0, 0]}},
    "stone_tile_named": {"type": "attrib_create", "in": ["stone_tile_placed"], "params": {"name": "name", "class": "prim", "value": "stone_swatch"}},
    "stone_swatch": {"type": "material", "in": ["stone_tile_named", "stone"], "params": {"name": "stone"}},
    "stone_swatch_checked": {"type": "assert", "in": ["stone_swatch"], "params": {"label": "swatches", "attrib": "uv", "attrib_class": "vertex", "expr": "pieces == 1"}},
    "wood_tile": {"type": "box", "params": {"size": [2, 0.04, 2], "center": [0, 0.02, 0]}},
    "wood_tile_uv": {"type": "uv_project", "in": ["wood_tile"], "params": {"method": "box", "scale": ["=tile_size", "=tile_size"]}},
    "wood_tile_placed": {"type": "transform", "in": ["wood_tile_uv"], "params": {"rotate": [0, 180, 0], "translate": [0.0, 0, 0]}},
    "wood_tile_named": {"type": "attrib_create", "in": ["wood_tile_placed"], "params": {"name": "name", "class": "prim", "value": "wood_swatch"}},
    "wood_swatch": {"type": "material", "in": ["wood_tile_named", "wood"], "params": {"name": "wood"}},
    "wood_swatch_checked": {"type": "assert", "in": ["wood_swatch"], "params": {"label": "swatches", "attrib": "uv", "attrib_class": "vertex", "expr": "pieces == 1"}},
    "metal_tile": {"type": "box", "params": {"size": [2, 0.04, 2], "center": [0, 0.02, 0]}},
    "metal_tile_uv": {"type": "uv_project", "in": ["metal_tile"], "params": {"method": "box", "scale": ["=tile_size", "=tile_size"]}},
    "metal_tile_placed": {"type": "transform", "in": ["metal_tile_uv"], "params": {"rotate": [0, 180, 0], "translate": [2.4, 0, 0]}},
    "metal_tile_named": {"type": "attrib_create", "in": ["metal_tile_placed"], "params": {"name": "name", "class": "prim", "value": "metal_swatch"}},
    "metal_swatch": {"type": "material", "in": ["metal_tile_named", "metal"], "params": {"name": "metal"}},
    "metal_swatch_checked": {"type": "assert", "in": ["metal_swatch"], "params": {"label": "swatches", "attrib": "uv", "attrib_class": "vertex", "expr": "pieces == 1"}},
    "all_swatches": {"type": "merge", "in": ["stone_swatch_checked", "wood_swatch_checked", "metal_swatch_checked"]},
    "swatches": {"type": "assert", "in": ["all_swatches"], "params": {"label": "swatches", "expr": "pieces == 3"}}
  },
  "output": "swatches",
  "outputs": {
    "stone": {"node": "stone", "label": "Stone blocks", "kind": "material", "tags": ["stone", "masonry", "tileable", "pbr"], "description": "Rough grey stone blocks with dark mortar: colour, normal and ORM maps."},
    "wood": {"node": "wood", "label": "Wood planks", "kind": "material", "tags": ["wood", "planks", "tileable", "pbr"], "description": "Warm brown wood planks with grain and knots: colour, normal and ORM maps."},
    "metal": {"node": "metal", "label": "Painted metal", "kind": "material", "tags": ["metal", "painted", "rust", "tileable", "pbr"], "description": "Blue painted metal plates with chipped edges and rust running from the rivets: colour, normal and ORM maps."},
    "swatches": {"node": "swatches", "label": "Swatches", "kind": "mesh", "tags": ["swatch", "preview", "materials"], "description": "A 2 m sample tile of each material, side by side, each with its material."}
  }
}
