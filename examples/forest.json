{
  "version": 1,
  "description": "The PCG chain with packed instancing: a slope mask times a height mask on a terrain (mask), 30,000 candidate points spread by that mask (scatter density_mask), upright random headings and sizes (orient), trees whose trunks would collide removed (prune overlap), then packed copies of three low-poly variants (pine, fir, oak) picked with weights (copy_to_points pack + variant_weights), and the whole scene rotated (instances compose the rotation). Stays a point cloud plus three small meshes until it is rendered or exported (glb: EXT_mesh_gpu_instancing, usda: PointInstancer, csv pcg: an Unreal PCG point stream).",
  "vars": { "tree_count": 30000, "seed": 4 },
  "nodes": {
    "terrain": {
      "type": "terrain",
      "params": { "size": [80, 80], "divisions": [140, 140], "height": 9, "frequency": 0.035, "octaves": 5, "seed": "=seed" }
    },
    "tint": {
      "type": "color",
      "in": ["terrain"],
      "params": { "mode": "ramp", "attrib": "height", "ramp": [[0, "#4d6b2f"], [0.55, "#6f7f3c"], [0.8, "#8a7b5a"], [1, "#d9d6cf"]] }
    },
    "gentle": {
      "type": "mask",
      "in": ["terrain"],
      "params": { "by": "slope", "min": 0, "max": 14, "falloff": 17 }
    },
    "below_tops": {
      "type": "mask",
      "in": ["gentle"],
      "params": { "by": "attribute", "source_attrib": "height", "min": -1, "max": 0.6, "falloff": 0.2, "combine": "multiply" }
    },
    "pts": {
      "type": "scatter",
      "in": ["below_tops"],
      "params": { "count": "=tree_count", "density_mask": "mask", "relax": false, "seed": "=seed" }
    },
    "upright": {
      "type": "orient",
      "in": ["pts"],
      "params": { "mode": "direction", "random_yaw": [0, 360], "tilt": [0, 4], "scale_min": 0.65, "scale_max": 1.35, "seed": "=seed" }
    },
    "spaced": {
      "type": "prune",
      "in": ["upright"],
      "params": { "mode": "overlap", "radius": 0.14, "priority": "largest", "seed": "=seed" }
    },
    "pine_trunk": { "type": "tube", "params": { "radius": 0.12, "height": 0.7, "center": [0, 0.35, 0], "cols": 5, "caps": false } },
    "pine_crown": { "type": "tube", "params": { "radius": 0.75, "radius_top": 0, "height": 2.6, "center": [0, 1.9, 0], "cols": 6 } },
    "pine_trunk_c": { "type": "color", "in": ["pine_trunk"], "params": { "color": "#5a3d26", "class": "prim" } },
    "pine_crown_c": { "type": "color", "in": ["pine_crown"], "params": { "color": "#2d5a34", "class": "prim" } },
    "pine_m": { "type": "merge", "in": ["pine_trunk_c", "pine_crown_c"] },
    "pine": { "type": "attrib_create", "in": ["pine_m"], "params": { "name": "name", "class": "prim", "value": "pine" } },
    "fir_trunk": { "type": "tube", "params": { "radius": 0.1, "height": 0.8, "center": [0, 0.4, 0], "cols": 5, "caps": false } },
    "fir_low": { "type": "tube", "params": { "radius": 0.6, "radius_top": 0.1, "height": 1.6, "center": [0, 1.4, 0], "cols": 6 } },
    "fir_high": { "type": "tube", "params": { "radius": 0.45, "radius_top": 0, "height": 1.8, "center": [0, 2.6, 0], "cols": 6 } },
    "fir_trunk_c": { "type": "color", "in": ["fir_trunk"], "params": { "color": "#4e3422", "class": "prim" } },
    "fir_crown": { "type": "merge", "in": ["fir_low", "fir_high"] },
    "fir_crown_c": { "type": "color", "in": ["fir_crown"], "params": { "color": "#1e4231", "class": "prim" } },
    "fir_m": { "type": "merge", "in": ["fir_trunk_c", "fir_crown_c"] },
    "fir": { "type": "attrib_create", "in": ["fir_m"], "params": { "name": "name", "class": "prim", "value": "fir" } },
    "oak_trunk": { "type": "tube", "params": { "radius": 0.16, "radius_top": 0.1, "height": 1.3, "center": [0, 0.65, 0], "cols": 5, "caps": false } },
    "oak_crown": { "type": "sphere", "params": { "type": "ico", "level": 1, "radius": 0.95, "center": [0, 1.9, 0], "scale": [1, 0.8, 1] } },
    "oak_trunk_c": { "type": "color", "in": ["oak_trunk"], "params": { "color": "#5d4129", "class": "prim" } },
    "oak_crown_c": { "type": "color", "in": ["oak_crown"], "params": { "color": "#55712a", "class": "prim" } },
    "oak_m": { "type": "merge", "in": ["oak_trunk_c", "oak_crown_c"] },
    "oak": { "type": "attrib_create", "in": ["oak_m"], "params": { "name": "name", "class": "prim", "value": "oak" } },
    "trees": { "type": "merge", "in": ["pine", "fir", "oak"] },
    "forest": {
      "type": "copy_to_points",
      "in": ["trees", "spaced"],
      "params": { "pack": true, "variants": "name", "variant_weights": [3, 2, 3], "seed": "=seed" }
    },
    "scene": { "type": "merge", "in": ["tint", "forest"] },
    "out": { "type": "transform", "in": ["scene"], "params": { "rotate": [0, 25, 0] } }
  },
  "output": "out",
  "meta": { "render": { "elevation": 30 } }
}
