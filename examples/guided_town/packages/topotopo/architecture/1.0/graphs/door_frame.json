{
  "version": 1,
  "description": "Door for a wall opening: jambs and head that fill the opening (width × height), a panelled leaf hinged on the left (-X) that swings towards -Z by open_angle, and lever handles on both sides. Pivot at the bottom centre of the opening, centred in depth. Pieces: door_frame (paint_white), door_leaf (door_paint), door_handle (brass). Every piece is a closed box.",
  "params": {
    "width": { "type": "float", "default": 1, "min": 0.5, "max": 3, "desc": "opening width (m)" },
    "height": { "type": "float", "default": 2.1, "min": 1.5, "max": 4, "desc": "opening height (m)" },
    "depth": { "type": "float", "default": 0.16, "min": 0.06, "max": 0.6, "desc": "frame depth along Z (m)" },
    "frame_width": { "type": "float", "default": 0.08, "min": 0.03, "max": 0.25, "desc": "jamb and head width (m)" },
    "panels": {
      "type": "int",
      "default": 2,
      "min": 0,
      "max": 5,
      "desc": "raised panels on each face of the leaf"
    },
    "open_angle": {
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 110,
      "desc": "how far the leaf is open (degrees)"
    }
  },
  "vars": { "width": 1, "height": 2.1, "depth": 0.16, "frame_width": 0.08, "panels": 2, "open_angle": 0 },
  "nodes": {
    "none": { "type": "points", "params": { "positions": [] } },
    "frame_pts": {
      "type": "wrangle",
      "in": ["none"],
      "params": {
        "run_over": "detail",
        "code": "const W = width, H = height, D = depth, f = Math.min(frame_width, W / 4);\nconst add = (p, s) => { const q = addpoint(0, p); setpointattrib(0, 'scale', q, s); };\nadd([-(W - f) / 2, H / 2, 0], [f, H, D]); add([(W - f) / 2, H / 2, 0], [f, H, D]); add([0, H - f / 2, 0], [W - 2 * f, f, D]);"
      }
    },
    "leaf_pts": {
      "type": "wrangle",
      "in": ["none"],
      "note": "the leaf, then raised panels on both faces",
      "params": {
        "run_over": "detail",
        "code": "const W = width, H = height, f = Math.min(frame_width, W / 4), t = 0.045;\nconst lw = W - 2 * f - 0.006, lh = H - f - 0.012, n = Math.round(panels), mx = Math.min(0.12, lw * 0.15), my = 0.12;\nconst add = (p, s) => { const q = addpoint(0, p); setpointattrib(0, 'scale', q, s); };\nadd([0, 0.008 + lh / 2, 0], [lw, lh, t]);\nconst ph = (lh - my * (n + 1)) / Math.max(1, n);\nfor (let i = 0; i < n; i++) for (const sz of [-1, 1]) add([0, 0.008 + my + i * (ph + my) + ph / 2, sz * (t / 2 + 0.006)], [lw - 2 * mx, ph, 0.012]);"
      }
    },
    "unit": { "type": "box" },
    "frame": { "type": "copy_to_points", "in": ["unit", "frame_pts"] },
    "frame_name": {
      "type": "attrib_create",
      "in": ["frame"],
      "params": { "name": "name", "class": "prim", "value": "door_frame" }
    },
    "frame_mat": {
      "type": "material",
      "in": ["frame_name"],
      "params": { "name": "paint_white", "base_color": "#e8e4da", "roughness": 0.5 }
    },
    "leaf": { "type": "copy_to_points", "in": ["unit", "leaf_pts"] },
    "leaf_name": {
      "type": "attrib_create",
      "in": ["leaf"],
      "params": { "name": "name", "class": "prim", "value": "door_leaf" }
    },
    "leaf_mat": {
      "type": "material",
      "in": ["leaf_name"],
      "params": { "name": "door_paint", "base_color": "#2f5d50", "roughness": 0.45 }
    },
    "handle_pts": {
      "type": "points",
      "params": {
        "positions": [["=(width - 2 * Math.min(frame_width, width / 4)) / 2 - 0.12", 1, 0.045], ["=(width - 2 * Math.min(frame_width, width / 4)) / 2 - 0.12", 1, -0.045]]
      }
    },
    "handle_unit": { "type": "box", "params": { "size": [0.13, 0.022, 0.022] } },
    "handles": { "type": "copy_to_points", "in": ["handle_unit", "handle_pts"] },
    "handle_name": {
      "type": "attrib_create",
      "in": ["handles"],
      "params": { "name": "name", "class": "prim", "value": "door_handle" }
    },
    "handle_mat": {
      "type": "material",
      "in": ["handle_name"],
      "params": { "name": "brass", "base_color": "#b8955a", "metallic": 0.9, "roughness": 0.3 }
    },
    "swing": { "type": "merge", "in": ["leaf_mat", "handle_mat"] },
    "open": {
      "type": "transform",
      "in": ["swing"],
      "params": {
        "rotate": [0, "=open_angle", 0],
        "pivot": ["=-(width - 2 * Math.min(frame_width, width / 4)) / 2", 0, 0]
      }
    },
    "all": { "type": "merge", "in": ["frame_mat", "open"] },
    "paint": {
      "type": "wrangle",
      "in": ["all"],
      "params": {
        "run_over": "prims",
        "code": "const m = JSON.parse(detail(0, 'materials') || '{}')[s@material]; if (m) @Cd = m.baseColor;"
      }
    },
    "out": { "type": "attrib_delete", "in": ["paint"], "params": { "names": "copynum" } }
  },
  "output": "out",
  "outputs": { "door_frame": { "node": "out", "label": "Door", "kind": "mesh", "tags": ["door", "wall-opening", "modular", "building"] } },
  "meta": {
    "watertight": true,
    "thumbnail_render": { "azimuth": 30, "elevation": 12 }
  }
}
