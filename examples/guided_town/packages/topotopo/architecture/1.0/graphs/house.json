{
  "description": "House built from a footprint polygon: one wall_segment per footprint edge (facing outward, floors stacked, a door on the first edge), topped with a roof_skeleton hip roof that follows the footprint exactly (straight skeleton: L-shapes, courtyards and any simple polygon get correct valleys and ridges). Input 0 is an optional closed polygon on the XZ ground plane; without it a width × depth rectangle is used. The walls, windows, doors and roof are this package's own wall_segment and roof_skeleton outputs, so a change to those changes every house. Pivot: the footprint's origin on the ground. Pieces come from those outputs (wall, window_frame, door_frame, roof).",
  "params": {
    "width": {
      "type": "float",
      "default": 8,
      "min": 3,
      "max": 30,
      "desc": "default footprint along X (m), used when no footprint is connected"
    },
    "depth": {
      "type": "float",
      "default": 6,
      "min": 3,
      "max": 30,
      "desc": "default footprint along Z (m)"
    },
    "floors": {
      "type": "int",
      "default": 2,
      "min": 1,
      "max": 4,
      "desc": "number of floors (wall segments stacked)"
    },
    "floor_height": {
      "type": "float",
      "default": 3,
      "min": 2.4,
      "max": 4.5,
      "desc": "height of one floor (m)"
    },
    "window_spacing": {
      "type": "float",
      "default": 2.5,
      "min": 1.5,
      "max": 6,
      "desc": "one window per this length of wall (m)"
    },
    "pitch": {
      "type": "float",
      "default": 32,
      "min": 5,
      "max": 65,
      "desc": "roof slope (degrees)"
    },
    "overhang": {
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 2,
      "desc": "eave overhang (m)"
    },
    "door": {
      "type": "bool",
      "default": true,
      "desc": "a door on the first footprint edge"
    }
  },
  "vars": {
    "width": 8,
    "depth": 6,
    "floors": 2,
    "floor_height": 3,
    "window_spacing": 2.5,
    "pitch": 32,
    "overhang": 0.5,
    "door": true
  },
  "meta": {
    "pivot": "footprint origin, ground",
    "thumbnail_render": {
      "azimuth": 30,
      "elevation": 22
    },
    "inputs": [
      "footprint"
    ]
  },
  "nodes": {
    "inp": {
      "type": "input",
      "params": {
        "index": 0,
        "label": "footprint: a closed polygon on the XZ plane (optional)"
      }
    },
    "rect": {
      "type": "grid",
      "params": {
        "size": [
          "=width",
          "=depth"
        ],
        "divisions": [
          1,
          1
        ]
      }
    },
    "fp": {
      "type": "switch",
      "in": [
        "inp",
        "rect"
      ],
      "params": {
        "index": "=npoints('inp') > 2 ? 0 : 1"
      }
    },
    "edges": {
      "type": "wrangle",
      "in": [
        "fp"
      ],
      "params": {
        "run_over": "prims",
        "code": "const pts = primpoints(0, @primnum); const n = pts.length;\n// winding of the footprint in the XZ plane decides which side is outside: for a positive signed area the left\n// normal (-dz, dx) points inward, so the edges are walked the other way round\nlet area = 0;\nfor (let k = 0; k < n; k++) { const a = point(0, 'P', pts[k]), b = point(0, 'P', pts[(k + 1) % n]); area += a[0] * b[2] - b[0] * a[2]; }\nconst flip = area > 0;\nfor (let k = 0; k < n; k++) {\n  let a = point(0, 'P', pts[k]), b = point(0, 'P', pts[(k + 1) % n]);\n  if (flip) { const t = a; a = b; b = t; }\n  const dx = b[0] - a[0], dz = b[2] - a[2];\n  const len = Math.sqrt(dx * dx + dz * dz);\n  if (len < 1e-6) continue;\n  const p0 = addpoint(0, [a[0], 0, a[2]]), p1 = addpoint(0, [b[0], 0, b[2]]);\n  const pr = addprim(0, 'polyline', [p0, p1]);\n  setprimattrib(0, 'len', pr, len);\n  setprimattrib(0, 'ang', pr, Math.atan2(-dz, dx) * 180 / Math.PI);\n  setprimattrib(0, 'x0', pr, a[0]);\n  setprimattrib(0, 'z0', pr, a[2]);\n}\nremoveprim(0, @primnum, true);"
      }
    },
    "walls": {
      "type": "foreach",
      "in": [
        "edges"
      ],
      "params": {
        "mode": "prims",
        "body": {
          "nodes": {
            "piece": {
              "type": "input",
              "params": {
                "index": 0
              }
            },
            "ground": {
              "type": "topotopo/architecture/wall_segment",
              "params": {
                "wall_length": "=prim('piece', 0, 'len')",
                "height": "=floor_height",
                "windows": "=max(0, floor(prim('piece', 0, 'len') / window_spacing))",
                "door": "=door && iteration == 0"
              }
            },
            "upper": {
              "type": "topotopo/architecture/wall_segment",
              "params": {
                "wall_length": "=prim('piece', 0, 'len')",
                "height": "=floor_height",
                "windows": "=max(0, floor(prim('piece', 0, 'len') / window_spacing))",
                "door": false
              }
            },
            "upper_up": {
              "type": "transform",
              "in": [
                "upper"
              ],
              "params": {
                "translate": [
                  0,
                  "=floor_height",
                  0
                ]
              }
            },
            "upper_stack": {
              "type": "copy_xform",
              "in": [
                "upper_up"
              ],
              "params": {
                "count": "=max(1, floors - 1)",
                "translate": [
                  0,
                  "=floor_height",
                  0
                ]
              }
            },
            "nothing": {
              "type": "null"
            },
            "upper_sel": {
              "type": "switch",
              "in": [
                "nothing",
                "upper_stack"
              ],
              "params": {
                "index": "=floors > 1 ? 1 : 0"
              }
            },
            "wall": {
              "type": "merge",
              "in": [
                "ground",
                "upper_sel"
              ]
            },
            "place": {
              "type": "transform",
              "in": [
                "wall"
              ],
              "params": {
                "rotate": [
                  0,
                  "=prim('piece', 0, 'ang')",
                  0
                ],
                "translate": [
                  "=prim('piece', 0, 'x0')",
                  0,
                  "=prim('piece', 0, 'z0')"
                ]
              }
            }
          },
          "output": "place"
        }
      }
    },
    "roof": {
      "type": "topotopo/architecture/roof_skeleton",
      "in": [
        "fp"
      ],
      "params": {
        "pitch": "=pitch",
        "overhang": "=overhang"
      }
    },
    "roof_place": {
      "type": "transform",
      "in": [
        "roof"
      ],
      "params": {
        "translate": [
          0,
          "=floors * floor_height",
          0
        ]
      }
    },
    "out": {
      "type": "merge",
      "in": [
        "walls",
        "roof_place"
      ]
    }
  },
  "output": "out",
  "outputs": { "house": { "node": "out", "label": "House", "kind": "mesh", "tags": ["house", "building", "residential", "footprint", "modular"] } }
}
