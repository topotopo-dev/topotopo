{
  "description": "Spline toolkit: a road (NURBS through waypoints) projected onto bumpy ground, a boardwalk whose linear NURBS path gets filleted corners and a 3D-offset double rail swept into handrails, and a Bezier letter outline converted to polylines and extruded.",
  "nodes": {
    "ground_grid": { "type": "grid", "params": { "size": [26, 18], "divisions": [52, 36] } },
    "ground": { "type": "noise_displace", "in": ["ground_grid"], "params": { "amplitude": 0.55, "frequency": 0.16, "seed": 3 } },
    "ground_col": { "type": "color", "in": ["ground"], "params": { "color": "#7d9a5b" } },

    "road_path": {
      "type": "nurbs",
      "params": { "points": [[-12, 6, 6.5], [-6, 6, 2.5], [0, 6, 5.5], [6, 6, 1.5], [12, 6, 4.5]], "fit": true, "parameterization": "centripetal" }
    },
    "road_on_ground": { "type": "project_curve", "in": ["road_path", "ground"], "params": { "spacing": 0.3, "lift": 0.12 } },
    "road_up": { "type": "wrangle", "in": ["road_on_ground"], "params": { "code": "@up = @N;" } },
    "road": { "type": "sweep", "in": ["road_up"], "params": { "shape": "ribbon", "radius": 1.2 } },
    "road_col": { "type": "color", "in": ["road"], "params": { "color": "#3a3d42" } },

    "walk_path": {
      "type": "nurbs",
      "params": { "points": [[-11, 0, -7], [-5, 0, -7], [-5, 0, -2], [2, 0, -2], [2, 0, -7], [10, 0, -7]], "order": 2 }
    },
    "walk_poly": { "type": "convert_curve", "in": ["walk_path"], "params": { "to": "polyline", "segments": 1 } },
    "walk_fillet": { "type": "fillet_curve", "in": ["walk_poly"], "params": { "radius": 1.6, "segments": 10 } },
    "walk_on_ground": { "type": "project_curve", "in": ["walk_fillet", "ground"], "params": { "spacing": 0.3, "lift": 0.45, "normals": false } },
    "walk_level": { "type": "attrib_create", "in": ["walk_on_ground"], "params": { "name": "up", "value": [0, 1, 0] } },
    "deck": { "type": "sweep", "in": ["walk_level"], "params": { "shape": "ribbon", "radius": 0.85 } },
    "deck_col": { "type": "color", "in": ["deck"], "params": { "color": "#9b6b43" } },
    "rails": { "type": "offset_curve_3d", "in": ["walk_level"], "params": { "distance": 0.75, "lift": 0.9, "both": true, "frame": "plane" } },
    "handrails": { "type": "sweep", "in": ["rails"], "params": { "radius": 0.05, "divisions": 8 } },
    "post_pts": { "type": "resample", "in": ["rails"], "params": { "length": 1.5 } },
    "post": { "type": "box", "params": { "size": [0.08, 0.95, 0.08], "center": [0, -0.47, 0] } },
    "posts": { "type": "copy_to_points", "in": ["post", "post_pts"] },
    "rail_parts": { "type": "merge", "in": ["handrails", "posts"] },
    "rail_col": { "type": "color", "in": ["rail_parts"], "params": { "color": "#d8d8d2" } },

    "letter_outer": {
      "type": "bezier",
      "params": {
        "closed": true,
        "points": [
          [0, 0, 0], [0.2, 0, 0], [0.4, 0, 0],
          [0.6, 0, 0], [0.6, 0.4, 0], [0.6, 0.8, 0],
          [0.6, 1.2, 0], [0.767, 1.2, 0], [0.933, 1.2, 0],
          [1.1, 1.2, 0], [2.2, 1.2, 0], [2.2, 3, 0],
          [1.1, 3, 0], [0.733, 3, 0], [0.367, 3, 0],
          [0, 3, 0], [0, 2, 0], [0, 1, 0]
        ]
      }
    },
    "letter_inner": {
      "type": "bezier",
      "params": {
        "closed": true,
        "points": [
          [0.6, 1.8, 0], [0.767, 1.8, 0], [0.933, 1.8, 0],
          [1.1, 1.8, 0], [1.55, 1.8, 0], [1.55, 2.4, 0],
          [1.1, 2.4, 0], [0.933, 2.4, 0], [0.767, 2.4, 0],
          [0.6, 2.4, 0], [0.6, 2.2, 0], [0.6, 2, 0]
        ]
      }
    },
    "letter_curves": { "type": "merge", "in": ["letter_outer", "letter_inner"] },
    "letter_poly": { "type": "convert_curve", "in": ["letter_curves"], "params": { "to": "polyline", "tolerance": 0.002 } },
    "letter_solid": { "type": "extrude", "in": ["letter_poly"], "params": { "height": 0.4 } },
    "letter": { "type": "transform", "in": ["letter_solid"], "params": { "translate": [8, 0.4, 6.5], "rotate": [0, 35, 0], "scale": 1.2 } },
    "letter_col": { "type": "color", "in": ["letter"], "params": { "color": "#d9572b" } },

    "out": { "type": "merge", "in": ["ground_col", "road_col", "deck_col", "rail_col", "letter_col"] }
  },
  "output": "out"
}
