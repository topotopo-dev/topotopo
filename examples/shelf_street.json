{
  "version": 1,
  "description": "A street block assembled from shelf assets only: a road with kerbs, sidewalks, lane markings and lamp posts on both sides; three houses (wall_segment walls with window_frame/door_frame, gable and hip roofs, one with two storeys, one behind a scaffold), a picket fence and bushes in front of them, crates, barrels and a pallet in the alley; across the street a brick garden wall with an arched gate, benches and a forest_patch park. Helper nodes only place the assets.",
  "vars": { "seed": 3 },
  "nodes": {
    "street_line": {
      "type": "line",
      "params": { "origin": [-24, 0, 0], "direction": [1, 0, 0], "length": 48, "points": 2 }
    },
    "road": {
      "type": "road_strip",
      "in": ["street_line"],
      "params": { "width": 7, "lanes": 2, "sidewalk_width": 2.5 }
    },
    "lamp_line": {
      "type": "points_along_curve",
      "in": ["street_line"],
      "params": { "spacing": 12, "start_offset": 6, "side_offset": 4.4, "both_sides": true }
    },
    "lamp_pts": {
      "type": "wrangle",
      "in": ["lamp_line"],
      "note": "arms point at the road",
      "params": { "code": "p@orient = quaternion(@P.z > 0 ? PI / 2 : -PI / 2, [0, 1, 0]);" }
    },
    "lamp": { "type": "lamp_post", "params": { "height": 5, "arm_length": 1.4 } },
    "lamps": { "type": "copy_to_points", "in": ["lamp", "lamp_pts"], "params": { "pack": true } },
    "sign": { "type": "sign_post", "params": { "text": "ELM ST", "cross_text": "MILL RD" } },
    "sign_at": { "type": "transform", "in": ["sign"], "params": { "translate": [-22, 0, 4.4] } },
    "a_front": { "type": "wall_segment", "params": { "wall_length": 8, "windows": 2, "door": true } },
    "a_front_xf": {
      "type": "transform",
      "in": ["a_front"],
      "params": { "rotate": [0, 180, 0], "translate": [8, 0, 0] }
    },
    "a_back": { "type": "wall_segment", "params": { "wall_length": 8, "windows": 2 } },
    "a_back_xf": { "type": "transform", "in": ["a_back"], "params": { "translate": [0, 0, 7] } },
    "a_side": { "type": "wall_segment", "params": { "wall_length": 7.25, "windows": 1 } },
    "a_left": {
      "type": "transform",
      "in": ["a_side"],
      "params": { "rotate": [0, -90, 0], "translate": [0, 0, -0.125] }
    },
    "a_right": {
      "type": "transform",
      "in": ["a_side"],
      "params": { "rotate": [0, 90, 0], "translate": [8, 0, 7.125] }
    },
    "a_roof": { "type": "roof_gable", "params": { "width": 8, "depth": 7, "pitch": 38 } },
    "a_roof_xf": { "type": "transform", "in": ["a_roof"], "params": { "translate": [4, 3, 3.5] } },
    "house_a": { "type": "merge", "in": ["a_front_xf", "a_back_xf", "a_left", "a_right", "a_roof_xf"] },
    "house_a_at": { "type": "transform", "in": ["house_a"], "params": { "translate": [-20, 0, 9] } },
    "b_front0": { "type": "wall_segment", "params": { "wall_length": 10, "windows": 2, "door": true } },
    "b_front1": { "type": "wall_segment", "params": { "wall_length": 10, "windows": 3, "sill_height": 0.8 } },
    "b_front1_up": { "type": "transform", "in": ["b_front1"], "params": { "translate": [0, 3, 0] } },
    "b_front": { "type": "merge", "in": ["b_front0", "b_front1_up"] },
    "b_front_xf": {
      "type": "transform",
      "in": ["b_front"],
      "params": { "rotate": [0, 180, 0], "translate": [10, 0, 0] }
    },
    "b_back_floor": { "type": "wall_segment", "params": { "wall_length": 10, "windows": 3 } },
    "b_back": {
      "type": "copy_xform",
      "in": ["b_back_floor"],
      "params": { "count": 2, "translate": [0, 3, 0], "copy_attrib": "" }
    },
    "b_back_xf": { "type": "transform", "in": ["b_back"], "params": { "translate": [0, 0, 8] } },
    "b_side_floor": { "type": "wall_segment", "params": { "wall_length": 8.25, "windows": 2 } },
    "b_side": {
      "type": "copy_xform",
      "in": ["b_side_floor"],
      "params": { "count": 2, "translate": [0, 3, 0], "copy_attrib": "" }
    },
    "b_left": {
      "type": "transform",
      "in": ["b_side"],
      "params": { "rotate": [0, -90, 0], "translate": [0, 0, -0.125] }
    },
    "b_right": {
      "type": "transform",
      "in": ["b_side"],
      "params": { "rotate": [0, 90, 0], "translate": [10, 0, 8.125] }
    },
    "b_roof": { "type": "roof_hip", "params": { "width": 10, "depth": 8, "pitch": 30 } },
    "b_roof_xf": { "type": "transform", "in": ["b_roof"], "params": { "translate": [5, 6, 4] } },
    "house_b": { "type": "merge", "in": ["b_front_xf", "b_back_xf", "b_left", "b_right", "b_roof_xf"] },
    "house_b_at": { "type": "transform", "in": ["house_b"], "params": { "translate": [-8.5, 0, 9] } },
    "c_front": { "type": "wall_segment", "params": { "wall_length": 7, "height": 3.4, "windows": 2, "door": true } },
    "c_front_xf": {
      "type": "transform",
      "in": ["c_front"],
      "params": { "rotate": [0, 180, 0], "translate": [7, 0, 0] }
    },
    "c_back": { "type": "wall_segment", "params": { "wall_length": 7, "height": 3.4, "windows": 1 } },
    "c_back_xf": { "type": "transform", "in": ["c_back"], "params": { "translate": [0, 0, 9] } },
    "c_side": { "type": "wall_segment", "params": { "wall_length": 9.25, "height": 3.4, "windows": 3 } },
    "c_left": {
      "type": "transform",
      "in": ["c_side"],
      "params": { "rotate": [0, -90, 0], "translate": [0, 0, -0.125] }
    },
    "c_right": {
      "type": "transform",
      "in": ["c_side"],
      "params": { "rotate": [0, 90, 0], "translate": [7, 0, 9.125] }
    },
    "c_roof": { "type": "roof_gable", "params": { "width": 9, "depth": 7, "pitch": 42, "overhang": 0.35 } },
    "c_roof_xf": {
      "type": "transform",
      "in": ["c_roof"],
      "note": "ridge at right angles to the street: the gable faces it",
      "params": { "rotate": [0, 90, 0], "translate": [3.5, 3.4, 4.5] }
    },
    "c_scaffold": { "type": "scaffold", "params": { "bays": 3, "lifts": 2, "bay_width": 2.3, "depth": 1 } },
    "c_scaffold_xf": {
      "type": "transform",
      "in": ["c_scaffold"],
      "params": { "rotate": [0, 180, 0], "translate": [7, 0, -0.95] }
    },
    "house_c": {
      "type": "merge",
      "in": ["c_front_xf", "c_back_xf", "c_left", "c_right", "c_roof_xf", "c_scaffold_xf"]
    },
    "house_c_at": { "type": "transform", "in": ["house_c"], "params": { "translate": [6.5, 0, 9] } },
    "fence_l": { "type": "fence", "params": { "run_length": 3.4, "style": "picket" } },
    "fence_l_at": { "type": "transform", "in": ["fence_l"], "params": { "translate": [-20, 0, 6.7] } },
    "fence_r": { "type": "fence", "params": { "run_length": 3.4, "style": "picket" } },
    "fence_r_at": { "type": "transform", "in": ["fence_r"], "params": { "translate": [-15.4, 0, 6.7] } },
    "hedge_pts": {
      "type": "points",
      "params": { "positions": [[-7.6, 0, 7], [-6.1, 0, 7.1], [-4.6, 0, 7], [0.8, 0, 7.1], [-0.6, 0, 7]] }
    },
    "hedge_bush": { "type": "bush", "params": { "size": 1.4, "height": 0.9, "seed": "=seed" } },
    "hedge": { "type": "copy_to_points", "in": ["hedge_bush", "hedge_pts"] },
    "crate_pts": {
      "type": "points",
      "params": {
        "positions": [[3, 0, 11], [3.15, 0, 12.1], [3.1, 0.8, 11.5]],
        "attribs": { "orient": [[0, 0.087, 0, 0.996], [0, -0.13, 0, 0.991], [0, 0.26, 0, 0.966]] }
      }
    },
    "crate": { "type": "crate", "params": { "width": 0.9, "height": 0.8, "depth": 0.9 } },
    "crates": { "type": "copy_to_points", "in": ["crate", "crate_pts"] },
    "barrel_pts": { "type": "points", "params": { "positions": [[4.3, 0, 10.6], [4.6, 0, 11.4], [4.2, 0, 13.6]] } },
    "barrel": { "type": "barrel", "params": { "seed": "=seed" } },
    "barrels": { "type": "copy_to_points", "in": ["barrel", "barrel_pts"] },
    "pallet": { "type": "pallet", "params": { "seed": "=seed" } },
    "pallet_at": {
      "type": "transform",
      "in": ["pallet"],
      "params": { "rotate": [0, 80, 0], "translate": [3.6, 0, 14.6] }
    },
    "yard_trees_pts": { "type": "points", "params": { "positions": [[-10.4, 0, 16], [16, 0, 12], [-22, 0, 14]] } },
    "yard_tree": { "type": "tree_lowpoly", "params": { "height": 7, "canopy_radius": 2.2, "seed": "=seed" } },
    "yard_trees": { "type": "copy_to_points", "in": ["yard_tree", "yard_trees_pts"] },
    "gate": { "type": "arch", "params": { "width": 3, "height": 3.2, "thickness": 0.45, "depth": 0.5 } },
    "gate_at": { "type": "transform", "in": ["gate"], "params": { "translate": [0, 0, -6.7] } },
    "garden_wall": { "type": "brick_wall", "params": { "wall_length": 15.6, "height": 0.9, "seed": "=seed" } },
    "wall_w": { "type": "transform", "in": ["garden_wall"], "params": { "translate": [-17.55, 0, -6.7] } },
    "wall_e": { "type": "transform", "in": ["garden_wall"], "params": { "translate": [1.95, 0, -6.7] } },
    "bench_pts": { "type": "points", "params": { "positions": [[-9, 0, -5.55], [9, 0, -5.55]] } },
    "bench": { "type": "bench", "params": { "seed": "=seed" } },
    "benches": { "type": "copy_to_points", "in": ["bench", "bench_pts"] },
    "bollard_pts": { "type": "points", "params": { "positions": [[-1.2, 0, -4.2], [0, 0, -4.2], [1.2, 0, -4.2]] } },
    "bollard": { "type": "bollard" },
    "bollards": { "type": "copy_to_points", "in": ["bollard", "bollard_pts"] },
    "park_ground": { "type": "grid", "params": { "size": [36, 11], "divisions": [18, 6], "center": [0, 0, -13.5] } },
    "park": {
      "type": "forest_patch",
      "in": ["park_ground"],
      "params": {
        "density": 0.03,
        "min_distance": 4,
        "min_height": 4.5,
        "max_height": 8,
        "conifer_ratio": 0.35,
        "seed": "=seed"
      }
    },
    "street": {
      "type": "merge",
      "in": ["road", "lamps", "sign_at", "house_a_at", "house_b_at", "house_c_at", "fence_l_at", "fence_r_at", "hedge", "crates", "barrels", "pallet_at", "yard_trees", "gate_at", "wall_w", "wall_e", "benches", "bollards", "park"]
    }
  },
  "output": "street",
  "meta": {
    "render": {
      "views": "persp",
      "azimuth": 212,
      "elevation": 24,
      "size": 1100,
      "zoom": 1.9,
      "look_at": [-3, 1.5, 5]
    }
  }
}
