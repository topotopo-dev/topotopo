{
  "version": 1,
  "description": "Unreal 5.8 demo scene: a 126 × 126 m eroded massif on a 253 × 253 heightfield (an exact Unreal Landscape fit: 63 quads per section, 2×2 sections, 2×2 components), a road cut along a curve with a road ribbon on top, Unreal weight layers (grass, rock, road), and packed instances: trees of three variants (pine, fir, oak) on gentle ground away from the road, rocks of two variants on steep slopes. Materials carry base colours. Node \"scene\" (the output) is the mesh scene for glb/usda/geo; node \"landscape\" (heightfield + road + instances) is the unreal_landscape bundle; node \"instances\" is the PCG instance stream. scripts/export-demo.ts writes all of them to out/unreal_demo/.",
  "vars": { "tree_density": 0.03, "rock_density": 0.05, "seed": 7 },
  "nodes": {
    "field": { "type": "heightfield", "params": { "size": [126, 126], "samples": [253, 253], "name": "massif" } },
    "massif": { "type": "heightfield_layer", "in": ["field"], "params": { "expression": "14 * (1 - smoothstep(6, 66, sqrt(x * x + (z + 6) * (z + 6))))" } },
    "ridges": { "type": "heightfield_noise", "in": ["massif"], "params": { "fractal": "ridged", "amplitude": 14, "element_size": 50, "range": "positive", "seed": 11 } },
    "detail": { "type": "heightfield_noise", "in": ["ridges"], "params": { "amplitude": 2, "element_size": 15, "seed": 5 } },
    "falloff": { "type": "heightfield_layer", "in": ["detail"], "params": { "expression": "height * (0.35 + 0.65 * (1 - smoothstep(18, 63, sqrt(x * x + (z + 6) * (z + 6)))))" } },
    "eroded": { "type": "heightfield_erode", "in": ["falloff"], "params": { "iterations": 60, "seed": 1, "erosion_radius": 2 } },
    "road_curve": { "type": "curve", "params": { "points": [[-62, 0, 36], [-30, 0, 21], [0, 0, 33], [30, 0, 18], [62, 0, 39]], "smooth": true } },
    "road_cut": { "type": "heightfield_path", "in": ["eroded", "road_curve"], "params": { "width": 6, "shoulder": 5, "smooth": 12, "bank": 4 } },
    "steep": { "type": "heightfield_mask_by_feature", "in": ["road_cut"], "params": { "feature": "slope", "layer": "rock", "min_angle": 30, "angle_falloff": 6 } },
    "w_road": { "type": "heightfield_layer", "in": ["steep"], "params": { "layer": "road", "expression": "path" } },
    "w_rock": { "type": "heightfield_layer", "in": ["w_road"], "params": { "layer": "rock", "expression": "rock * (1 - road)" } },
    "w_grass": { "type": "heightfield_layer", "in": ["w_rock"], "params": { "layer": "grass", "expression": "Math.max(0, 1 - rock - road)" } },
    "zones": { "type": "heightfield_layer", "in": ["w_grass"], "params": { "layer": "trees", "expression": "grass * (1 - smoothstep(0.05, 0.4, road + 0)) * (1 - smoothstep(14, 18, height))" } },
    "layers": { "type": "heightfield_layer", "in": ["zones"], "params": { "layer": "mask", "expression": "rock" } },

    "tree_pts": { "type": "heightfield_scatter", "in": ["layers"], "params": { "density": "=tree_density", "mask_layer": "trees", "seed": "=seed" } },
    "tree_variant": { "type": "attrib_randomize", "in": ["tree_pts"], "params": { "name": "variant", "distribution": "choice", "values": ["pine", "fir", "oak"], "seed": "=seed + 1" } },
    "tree_xform": {
      "type": "wrangle", "in": ["tree_variant"],
      "params": { "code": "// upright trees, random heading and size; id and a colour variation value travel per instance\nconst a = rand(@ptnum + 0.37) * 6.2832;\n@N = [Math.sin(a), 0, Math.cos(a)];\n@up = [0, 1, 0];\n@pscale = fit(rand(@ptnum + 7.1), 0, 1, 1.4, 2.6);\ni@id = @ptnum;\nf@tint = rand(@ptnum + 3.3);" }
    },
    "pine_trunk": { "type": "tube", "params": { "radius": 0.12, "height": 0.7, "center": [0, 0.35, 0], "cols": 6, "caps": false } },
    "pine_crown": { "type": "tube", "params": { "radius": 0.75, "radius_top": 0, "height": 2.6, "center": [0, 1.9, 0], "cols": 7 } },
    "pine_trunk_m": { "type": "material", "in": ["pine_trunk"], "params": { "name": "bark", "base_color": "#5a3d26", "roughness": 0.9 } },
    "pine_crown_m": { "type": "material", "in": ["pine_crown"], "params": { "name": "pine_needles", "base_color": "#2d5a34", "roughness": 0.8 } },
    "pine_m": { "type": "merge", "in": ["pine_trunk_m", "pine_crown_m"] },
    "pine": { "type": "attrib_create", "in": ["pine_m"], "params": { "name": "name", "class": "prim", "value": "pine" } },
    "fir_trunk": { "type": "tube", "params": { "radius": 0.1, "height": 0.8, "center": [0, 0.4, 0], "cols": 6, "caps": false } },
    "fir_low": { "type": "tube", "params": { "radius": 0.6, "radius_top": 0.1, "height": 1.6, "center": [0, 1.4, 0], "cols": 7 } },
    "fir_high": { "type": "tube", "params": { "radius": 0.45, "radius_top": 0, "height": 1.8, "center": [0, 2.6, 0], "cols": 7 } },
    "fir_trunk_m": { "type": "material", "in": ["fir_trunk"], "params": { "name": "bark", "base_color": "#5a3d26", "roughness": 0.9 } },
    "fir_crown": { "type": "merge", "in": ["fir_low", "fir_high"] },
    "fir_crown_m": { "type": "material", "in": ["fir_crown"], "params": { "name": "fir_needles", "base_color": "#1e4231", "roughness": 0.8 } },
    "fir_m": { "type": "merge", "in": ["fir_trunk_m", "fir_crown_m"] },
    "fir": { "type": "attrib_create", "in": ["fir_m"], "params": { "name": "name", "class": "prim", "value": "fir" } },
    "oak_trunk": { "type": "tube", "params": { "radius": 0.16, "radius_top": 0.1, "height": 1.3, "center": [0, 0.65, 0], "cols": 6, "caps": false } },
    "oak_crown": { "type": "sphere", "params": { "type": "ico", "level": 1, "radius": 0.95, "center": [0, 1.9, 0], "scale": [1, 0.8, 1] } },
    "oak_trunk_m": { "type": "material", "in": ["oak_trunk"], "params": { "name": "bark", "base_color": "#5a3d26", "roughness": 0.9 } },
    "oak_crown_m": { "type": "material", "in": ["oak_crown"], "params": { "name": "oak_leaves", "base_color": "#55712a", "roughness": 0.75 } },
    "oak_m": { "type": "merge", "in": ["oak_trunk_m", "oak_crown_m"] },
    "oak": { "type": "attrib_create", "in": ["oak_m"], "params": { "name": "name", "class": "prim", "value": "oak" } },
    "tree_srcs": { "type": "merge", "in": ["pine", "fir", "oak"] },
    "trees": { "type": "copy_to_points", "in": ["tree_srcs", "tree_xform"], "params": { "pack": true, "variants": "name", "variant_attrib": "variant" } },

    "rock_pts": { "type": "heightfield_scatter", "in": ["layers"], "params": { "density": "=rock_density", "mask_layer": "rock", "seed": "=seed + 2" } },
    "rock_variant": { "type": "attrib_randomize", "in": ["rock_pts"], "params": { "name": "variant", "distribution": "choice", "values": ["rock_a", "rock_b"], "seed": "=seed + 3" } },
    "rock_orient": { "type": "attrib_randomize", "in": ["rock_variant"], "params": { "name": "orient", "distribution": "orient", "seed": "=seed + 4" } },
    "rock_xform": { "type": "wrangle", "in": ["rock_orient"], "params": { "code": "@pscale = fit(rand(@ptnum + 1.9), 0, 1, 0.5, 1.4);\ni@id = 100000 + @ptnum;\nf@tint = rand(@ptnum + 8.1);" } },
    "rock_a_shape": { "type": "sphere", "params": { "type": "ico", "level": 2, "radius": 1 } },
    "rock_a_noise": { "type": "noise_displace", "in": ["rock_a_shape"], "params": { "amplitude": 0.35, "frequency": 1.3 } },
    "rock_a_m": { "type": "material", "in": ["rock_a_noise"], "params": { "name": "rock", "base_color": [0.42, 0.4, 0.38], "roughness": 0.95 } },
    "rock_a": { "type": "attrib_create", "in": ["rock_a_m"], "params": { "name": "name", "class": "prim", "value": "rock_a" } },
    "rock_b_shape": { "type": "sphere", "params": { "type": "ico", "level": 1, "radius": 1, "scale": [1.4, 0.6, 1] } },
    "rock_b_noise": { "type": "noise_displace", "in": ["rock_b_shape"], "params": { "amplitude": 0.25, "frequency": 1.7, "seed": 3 } },
    "rock_b_m": { "type": "material", "in": ["rock_b_noise"], "params": { "name": "rock", "base_color": [0.42, 0.4, 0.38], "roughness": 0.95 } },
    "rock_b": { "type": "attrib_create", "in": ["rock_b_m"], "params": { "name": "name", "class": "prim", "value": "rock_b" } },
    "rock_srcs": { "type": "merge", "in": ["rock_a", "rock_b"] },
    "rocks": { "type": "copy_to_points", "in": ["rock_srcs", "rock_xform"], "params": { "pack": true, "variants": "name", "variant_attrib": "variant" } },
    "instances": { "type": "merge", "in": ["trees", "rocks"] },

    "terrain_mesh": { "type": "heightfield_to_mesh", "in": ["layers"], "params": { "color": "terrain", "layers": false } },
    "terrain_m": { "type": "material", "in": ["terrain_mesh"], "params": { "name": "ground", "base_color": "#6f7f3c", "roughness": 0.95 } },
    "terrain": { "type": "attrib_create", "in": ["terrain_m"], "params": { "name": "name", "class": "prim", "value": "terrain" } },
    "road_pts": { "type": "resample", "in": ["road_curve"], "params": { "length": 1 } },
    "road_snap": { "type": "ray", "in": ["road_pts", "terrain_mesh"], "params": { "direction": [0, -1, 0], "lift": 0.06, "orient": false } },
    "road_strip": { "type": "sweep", "in": ["road_snap"], "params": { "shape": "ribbon", "radius": 3, "up": [0, 1, 0], "uv_length": true } },
    "road_m": { "type": "material", "in": ["road_strip"], "params": { "name": "asphalt", "base_color": "#3a3a3c", "roughness": 0.85 } },
    "road": { "type": "attrib_create", "in": ["road_m"], "params": { "name": "name", "class": "prim", "value": "road" } },

    "landscape": { "type": "merge", "in": ["layers", "road", "instances"] },
    "scene": { "type": "merge", "in": ["terrain", "road", "instances"] }
  },
  "output": "scene",
  "meta": { "render": { "elevation": 32, "azimuth": 30 } }
}
