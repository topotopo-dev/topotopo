{
  "version": 1,
  "meta": {
    "description": "Left: sharp dual-contour voxel remesh. Centre: marching cubes from the same grid. Right: dilated, eroded and blurred distances. Two boxes intersect a torus.",
    "render": { "views": ["persp"], "size": 1200, "azimuth": 25, "elevation": 28 }
  },
  "nodes": {
    "box_a": { "type": "box", "params": { "size": [1.5, 1.35, 0.7], "center": [-0.35, 0.12, 0] } },
    "box_b": { "type": "box", "params": { "size": [0.55, 1.9, 0.8], "center": [0.35, 0.35, 0.05] } },
    "ring": { "type": "torus", "params": { "radius": 0.9, "radius2": 0.24, "rows": 20, "cols": 64, "center": [0, 0.05, 0] } },
    "boxes": { "type": "boolean", "in": ["box_a", "box_b"], "params": { "operation": "union" } },
    "parts": { "type": "boolean", "in": ["boxes", "ring"], "params": { "operation": "union" } },
    "grid": { "type": "sdf_grid", "in": ["parts"], "params": { "voxel_size": 0.06, "padding": 6, "band": 3, "fill": true } },
    "dc": { "type": "grid_to_mesh", "in": ["grid"], "params": { "method": "dual_contouring", "sharp": true } },
    "dc_color": { "type": "color", "in": ["dc"], "params": { "color": "#de985e" } },
    "left": { "type": "transform", "in": ["dc_color"], "params": { "translate": [-3.1, 0, 0] } },
    "mc": { "type": "grid_to_mesh", "in": ["grid"], "params": { "method": "marching_cubes" } },
    "centre": { "type": "color", "in": ["mc"], "params": { "color": "#71afc7" } },
    "dilate": { "type": "grid_dilate", "in": ["grid"], "params": { "distance": 0.16 } },
    "erode": { "type": "grid_erode", "in": ["dilate"], "params": { "distance": 0.08 } },
    "blur": { "type": "grid_blur", "in": ["erode"], "params": { "radius": 2 } },
    "variant": { "type": "grid_to_mesh", "in": ["blur"], "params": { "sharp": false } },
    "variant_color": { "type": "color", "in": ["variant"], "params": { "color": "#9bba78" } },
    "right": { "type": "transform", "in": ["variant_color"], "params": { "translate": [3.1, 0, 0] } },
    "out": { "type": "merge", "in": ["left", "centre", "right"] }
  },
  "output": "out"
}
