{
  "description": "Deformers: a twisted column bent by a lattice cage (cage shown as wire), a chain of boxes wrapped along a spiral with path_deform, and a grid pulled up with soft_transform (coloured by its soft weight).",
  "vars": { "bend": 55, "links": 42, "lift": 1.2 },
  "nodes": {
    "shaft": { "type": "box", "params": { "size": [0.5, 3, 0.5], "center": [-3.5, 1.5, 0], "divisions": [4, 36, 4] } },
    "twisted": { "type": "twist", "in": ["shaft"], "params": { "angle": 120 } },
    "cage": { "type": "bound", "in": ["twisted"], "params": { "divisions": [1, 6, 1], "padding": [0.05, 0, 0.05] } },
    "cage_bent": { "type": "bend", "in": ["cage"], "params": { "angle": "=bend", "toward": "x" } },
    "column": { "type": "lattice", "in": ["twisted", "cage", "cage_bent"] },
    "column_col": { "type": "color", "in": ["column"], "params": { "color": "#d8cfc0" } },
    "cage_wire": { "type": "polywire", "in": ["cage_bent"], "params": { "radius": 0.012, "divisions": 6 } },
    "cage_col": { "type": "color", "in": ["cage_wire"], "params": { "color": "#e07a2e" } },

    "link": { "type": "box", "params": { "size": [0.16, 0.06, 0.26] } },
    "chain": { "type": "copy_xform", "in": ["link"], "params": { "count": "=links", "translate": [0, 0, 0.3], "rotate": [0, 0, 90] } },
    "spiral": { "type": "spiral", "params": { "radius": 1, "height": 2.4, "turns": 2, "points_per_turn": 48, "center": [0, 0.3, 0] } },
    "wrapped": { "type": "path_deform", "in": ["chain", "spiral"], "params": { "stretch": true } },
    "chain_col": { "type": "color", "in": ["wrapped"], "params": { "color": "#5b6b7a" } },

    "sheet": { "type": "grid", "params": { "size": [3, 3], "divisions": [40, 40], "center": [3.5, 0, 0] } },
    "pulled": {
      "type": "soft_transform",
      "in": ["sheet"],
      "params": {
        "group": "@P.x>3.49 ^@P.x>3.51 ^@P.z>0.01 ^@P.z<-0.01",
        "translate": [0, "=lift", 0],
        "radius": 1.3,
        "falloff": "smooth",
        "weight_attrib": "softweight"
      }
    },
    "sheet_col": {
      "type": "color",
      "in": ["pulled"],
      "params": { "mode": "ramp", "attrib": "softweight", "range": [0, 1], "ramp": [[0, "#1d2b53"], [0.5, "#2a9d8f"], [1, "#f4e285"]] }
    },

    "out": { "type": "merge", "in": ["column_col", "cage_col", "chain_col", "sheet_col"] }
  },
  "output": "out"
}
