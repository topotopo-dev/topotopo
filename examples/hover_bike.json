    },
    "screen_mat_named": {
      "type": "attrib_create",
      "in": [
        "screen_mat"
      ],
      "params": {
        "name": "name",
        "class": "prim",
        "value": "windscreen"
      }
    },
    "seat_named": {
      "type": "attrib_create",
      "in": [
        "seat"
      ],
      "params": {
        "name": "name",
        "class": "prim",
        "value": "seat"
      }
    },
    "stem_named": {
      "type": "attrib_create",
      "in": [
        "stem"
      ],
      "params": {
        "name": "name",
        "class": "prim",
        "value": "stem"
      }
    },
    "bars_named": {
      "type": "attrib_create",
      "in": [
        "bars"
      ],
      "params": {
        "name": "name",
        "class": "prim",
        "value": "handlebars"
      }
    },
    "all": {
      "type": "merge",
      "in": [
        "skin_named",
        "disc_front_place_named",
        "disc_rear_place_named",
        "screen_mat_named",
        "seat_named",
        "stem_named",
        "bars_named"
      ]
    },
    "bike": {
      "type": "match_size",
      "in": [
        "all"
      ],
      "params": {
        "justify": [
          "none",
          "min",
          "none"
        ],
        "target": [
          0,
          "=hover_height",
          0
        ]
      }
    },
    "closed": {
      "type": "assert",
      "in": [
        "bike"
      ],
      "params": {
        "label": "closed",
        "watertight": true,
        "no_flipped": true
      }
    },
    "hovering": {
      "type": "assert",
      "in": [
        "closed"
      ],
      "params": {
        "label": "hovering",
        "expr": "abs(bbox.min.y - hover_height) < 0.002",
        "tolerance": 0.00001
      }
    },
    "budget": {
      "type": "assert",
      "in": [
        "hovering"
      ],
      "params": {
        "label": "budget",
        "expr": "nvertices - 2 * nprims < 10000"
      }
    }
  },
  "outputs": {
    "bike": {
      "node": "budget",
      "label": "Hover bike",
      "kind": "mesh",
      "tags": [
        "hover-bike",
        "sci-fi",
        "vehicle",
        "prop",
        "smooth",
        "game-ready"
      ],
      "description": "A sleek hover bike in one closed set of pieces: a flowing off-white and graphite body with a drooping nose, a raised tail and two glowing thruster pods, a recessed seat, a windscreen and low handlebars."
    }
  },
  "output": "budget"
}