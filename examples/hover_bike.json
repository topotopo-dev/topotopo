{
  "version": 1,
  "description": "A sleek hover bike: one flowing body drawn as six long lines along its length (keel, underside edge, character line, shoulder, crown and roof line) and skinned into a smooth surface that passes through them, with a pointed drooping nose and a tail that rises. Two thruster pods grow out of the flat underside as pushed-down patches, with a glow disc in each bottom; the windscreen is a strip of the body top tilted up.",
  "params": {
    "bike_length": {
      "type": "float",
      "default": 2.3,
      "min": 1.8,
      "max": 2.8,
      "step": 0.05,
      "label": "length",
      "desc": "length of the bike from nose to tail (m)"
    },
    "width": {
      "type": "float",
      "default": 0.8,
      "min": 0.65,
      "max": 1,
      "step": 0.01,
      "label": "width",
      "desc": "widest point of the body, at the character line (m)"
    },
    "pod_size": {
      "type": "float",
      "default": 1,
      "min": 0.7,
      "max": 1.3,
      "step": 0.05,
      "label": "pod size",
      "desc": "size of the two thruster pods under the body (1 = standard)"
    },
    "nose_droop": {
      "type": "float",
      "default": 0.06,
      "min": 0,
      "max": 0.15,
      "step": 0.005,
      "label": "nose droop",
      "desc": "how far the tip of the nose hangs below its neutral height (m)"
    },
    "tail_rise": {
      "type": "float",
      "default": 0.1,
      "min": 0,
      "max": 0.25,
      "step": 0.005,
      "label": "tail rise",
      "desc": "how far the tail lifts above its neutral height (m)"
    },
    "line_crease": {
      "type": "float",
      "default": 2,
      "min": 0,
      "max": 3,
      "step": 0.1,
      "label": "line crease",
      "desc": "sharpness of the two character lines along the flanks (0 = soft, 2 = crisp)"
    },
    "hover_height": {
      "type": "float",
      "default": 0.15,
      "min": 0.05,
      "max": 0.5,
      "step": 0.01,
      "label": "hover height",
      "desc": "height of the lowest point of the bike above the ground (m)"
    }
  },
  "vars": {
    "bike_length": 2.3,
    "width": 0.8,
    "pod_size": 1,
    "nose_droop": 0.06,
    "tail_rise": 0.1,
    "line_crease": 2,
    "hover_height": 0.15
  },
  "meta": {
    "render": {
      "views": [
        "persp"
      ],
      "azimuth": 35,
      "elevation": 14,
      "size": "1600x900",
      "shading": "pbr",
      "grid": false
    }
  },
