{
  "FileVersion": 3,
  "Version": 7,
  "VersionName": "0.2.0",
  "FriendlyName": "TopoTopo",
  "Description": "Imports TopoTopo packages (.topo), reads point streams, spawns PCG instances and imports Landscapes and scenes.",
  "Category": "Procedural",
  "CreatedBy": "faxcorp",
  "CreatedByURL": "https://topotopo.dev",
  "EngineVersion": "5.8.0",
  "CanContainContent": false,
  "IsBetaVersion": true,
  "Installed": false,
  "SupportedTargetPlatforms": ["Win64"],
  "Modules": [
    { "Name": "TopoTopoPCG", "Type": "Runtime", "LoadingPhase": "Default" },
    { "Name": "TopoTopoPCGEditor", "Type": "Editor", "LoadingPhase": "PostEngineInit" },
    { "Name": "TopoTopoImport", "Type": "Runtime", "LoadingPhase": "Default" },
    { "Name": "TopoTopoImportEditor", "Type": "Editor", "LoadingPhase": "Default" }
  ],
  "Plugins": [
    { "Name": "PCG", "Enabled": true },
    { "Name": "Interchange", "Enabled": true }
  ]
}
