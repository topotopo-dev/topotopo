{
  "description": "A crate: a bevelled box with a plank texture (LOD 0) and a plain box (LOD 1), a handle socket on the lid and a socket on each side.",
  "vars": {"width": 0.8},
  "params": {"width": {"type": "float", "default": 0.8, "min": 0.4, "max": 2, "label": "Width", "desc": "The crate's width in metres; the side sockets follow it."}},
  "nodes": {
    "body": {"type": "box", "params": {"size": ["=width", 0.6, 0.6]}},
    "rounded": {"type": "poly_bevel", "in": ["body"], "params": {"offset": 0.03}},
    "lod0": {"type": "attrib_create", "in": ["rounded"], "params": {"name": "name", "class": "prim", "value": "crate_lod0"}},
    "lod1": {"type": "attrib_create", "in": ["body"], "params": {"name": "name", "class": "prim", "value": "crate_lod1"}},
    "pieces": {"type": "merge", "in": ["lod0", "lod1"]},
    "planks": {"type": "tex_pattern", "params": {"resolution": [256, 256], "pattern": "stripes", "count": [5, 1], "gap": 0.1, "bevel": 0.1, "variation": 0.45, "seed": 4}},
    "wood": {"type": "tex_colorize", "in": ["planks"], "params": {"ramp": [[0, "#24160b"], [0.5, "#6e4526"], [1, "#c08a56"]]}},
    "textured": {"type": "merge", "in": ["pieces", "wood"]},
    "paint": {"type": "material", "in": ["textured"], "params": {"name": "crate_wood", "base_color_map": "image:wood", "roughness": 0.8}},
    "handle": {"type": "scene_null", "in": ["paint"], "params": {"name": "handle", "translation": [0, 0.32, 0]}},
    "side_left": {"type": "scene_null", "in": ["handle"], "params": {"name": "side_left", "translation": ["=-width / 2 - 0.02", 0, 0], "rotation": [0, -90, 0]}},
    "side_right": {"type": "scene_null", "in": ["side_left"], "params": {"name": "side_right", "translation": ["=width / 2 + 0.02", 0, 0], "rotation": [0, 90, 0]}}
  },
  "output": "side_right",
  "outputs": {
    "crate": {"node": "side_right", "label": "Crate", "kind": "mesh", "tags": ["crate", "prop"], "description": "A crate with three sockets, in two LOD pieces."}
  }
}
