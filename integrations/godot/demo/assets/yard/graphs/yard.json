{
  "description": "A yard: its ground, and stones scattered on it as packed instances (MultiMeshInstance3D in Godot), each turned, scaled and tinted on its own.",
  "nodes": {
    "ground": {"type": "grid", "params": {"size": [6, 6], "divisions": [12, 12]}},
    "soil": {"type": "material", "in": ["ground"], "params": {"name": "soil", "base_color": "#6b5a3e", "roughness": 0.95}},
    "a": {"type": "sphere", "params": {"type": "ico", "level": 1, "radius": 0.18}},
    "a_named": {"type": "attrib_create", "in": ["a"], "params": {"name": "name", "class": "prim", "value": "stone_round"}},
    "b": {"type": "box", "params": {"size": [0.3, 0.18, 0.24]}},
    "b_named": {"type": "attrib_create", "in": ["b"], "params": {"name": "name", "class": "prim", "value": "stone_block"}},
    "c": {"type": "tube", "params": {"radius": 0.12, "height": 0.3, "cols": 6}},
    "c_named": {"type": "attrib_create", "in": ["c"], "params": {"name": "name", "class": "prim", "value": "stone_pillar"}},
    "kit": {"type": "merge", "in": ["a_named", "b_named", "c_named"]},
    "stone": {"type": "material", "in": ["kit"], "params": {"name": "stone", "base_color": "#ffffff", "roughness": 0.85}},
    "spots": {"type": "scatter", "in": ["ground"], "params": {"count": 40, "seed": 3, "min_distance": 0.45}},
    "dress": {"type": "wrangle", "in": ["spots"], "params": {"code": "i@variant = floor(rand(@ptnum, 1) * 3); p@orient = quaternion(radians(rand(@ptnum, 2) * 360), set(0, 1, 0)); v@scale = set(0.7 + rand(@ptnum, 3) * 0.8, 0.6 + rand(@ptnum, 4) * 0.6, 0.7 + rand(@ptnum, 5) * 0.8); const g = 0.45 + rand(@ptnum, 6) * 0.3; v@Cd = set(g, g * 0.97, g * 0.9);"}},
    "stones": {"type": "copy_to_points", "in": ["stone", "dress"], "params": {"pack": true, "variants": "name"}}
  },
  "output": "soil",
  "outputs": {
    "ground": {"node": "soil", "label": "Ground", "kind": "mesh", "tags": ["ground"], "description": "The yard's ground."},
    "stones": {"node": "stones", "label": "Stones", "kind": "instances", "tags": ["stones", "scatter"], "description": "Stones scattered on the ground, as instances."}
  }
}
