{
  "version": 1,
  "description": "Forest on a surface (input 0; without one, a 30 × 30 m ground patch at y = 0): trees scattered by density with a minimum spacing on faces flatter than max_slope, kept upright with random yaw and height, as packed copies of three tree_lowpoly variants (conifer, round, poplar) picked by conifer_ratio, plus optional bushes between them. Output: packed instances (unpack for polygons); the input surface is not included. Pivot = the surface. Pieces: tree_trunk, tree_canopy, bush.",
  "params": {
    "density": {
      "type": "float",
      "default": 0.02,
      "min": 0.001,
      "max": 0.5,
      "desc": "trees per square metre before spacing"
    },
    "min_distance": {
      "type": "float",
      "default": 3,
      "min": 0.5,
      "max": 20,
      "desc": "minimum distance between trees (m)"
    },
    "min_height": { "type": "float", "default": 4, "min": 1, "max": 30, "desc": "smallest tree height (m)" },
    "max_height": { "type": "float", "default": 9, "min": 1, "max": 40, "desc": "largest tree height (m)" },
    "conifer_ratio": {
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "desc": "share of conifers; the rest is split between round and poplar trees"
    },
    "max_slope": {
      "type": "float",
      "default": 30,
      "min": 0,
      "max": 90,
      "desc": "no trees on faces steeper than this (degrees)"
    },
    "bushes": { "type": "bool", "default": true, "desc": "scatter bushes (three times the tree density)" },
    "ground_size": {
      "type": "float",
      "default": 30,
      "min": 2,
      "max": 200,
      "desc": "size of the ground patch used when nothing is connected (m)"
    },
    "seed": { "type": "int", "default": 0, "min": 0, "max": 1000, "desc": "random seed" }
  },
  "vars": {
    "density": 0.02,
    "min_distance": 3,
    "min_height": 4,
    "max_height": 9,
    "conifer_ratio": 0.5,
    "max_slope": 30,
    "bushes": true,
    "ground_size": 30,
    "seed": 0
  },
  "nodes": {
    "surface_in": { "type": "input", "params": { "index": 0, "label": "surface to plant on (polygons); optional" } },
    "patch": { "type": "grid", "params": { "size": ["=ground_size", "=ground_size"], "divisions": [10, 10] } },
    "surface": {
      "type": "switch",
      "in": ["patch", "surface_in"],
      "params": { "index": "=nprims('surface_in') > 0 ? 1 : 0" }
    },
    "flat_enough": {
      "type": "mask",
      "in": ["surface"],
      "params": { "by": "slope", "min": 0, "max": "=max_slope", "falloff": 4 }
    },
    "tree_pts": {
      "type": "scatter",
      "in": ["flat_enough"],
      "params": {
        "generate_by": "density",
        "density": "=density",
        "density_mask": "mask",
        "min_distance": "=min_distance",
        "seed": "=seed"
      }
    },
    "tree_xf": {
      "type": "orient",
      "in": ["tree_pts"],
      "params": {
        "mode": "normal_up",
        "upright": true,
        "random_yaw": [0, 360],
        "scale_min": "=min_height / 6",
        "scale_max": "=Math.max(min_height, max_height) / 6",
        "seed": "=seed"
      }
    },
    "conifer": {
      "type": "topotopo/nature/tree_lowpoly",
      "params": { "height": 6, "style": "conifer", "canopy_radius": 1.7, "seed": 1 }
    },
    "conifer_id": {
      "type": "attrib_create",
      "in": ["conifer"],
      "params": { "name": "variant_id", "class": "prim", "value": 0 }
    },
    "round": {
      "type": "topotopo/nature/tree_lowpoly",
      "params": { "height": 6, "style": "round", "canopy_radius": 1.9, "seed": 2 }
    },
    "round_id": {
      "type": "attrib_create",
      "in": ["round"],
      "params": { "name": "variant_id", "class": "prim", "value": 1 }
    },
    "poplar": {
      "type": "topotopo/nature/tree_lowpoly",
      "params": { "height": 6, "style": "poplar", "canopy_radius": 1.5, "seed": 3 }
    },
    "poplar_id": {
      "type": "attrib_create",
      "in": ["poplar"],
      "params": { "name": "variant_id", "class": "prim", "value": 2 }
    },
    "trees_src": { "type": "merge", "in": ["conifer_id", "round_id", "poplar_id"] },
    "trees": {
      "type": "copy_to_points",
      "in": ["trees_src", "tree_xf"],
      "params": {
        "pack": true,
        "piece_attrib": "variant_id",
        "variant_weights": "=[conifer_ratio, (1 - conifer_ratio) / 2, (1 - conifer_ratio) / 2]",
        "seed": "=seed"
      }
    },
    "bush_pts": {
      "type": "scatter",
      "in": ["flat_enough"],
      "params": {
        "generate_by": "density",
        "density": "=density * 3",
        "density_mask": "mask",
        "min_distance": "=min_distance * 0.4",
        "seed": "=seed + 17"
      }
    },
    "bush_xf": {
      "type": "orient",
      "in": ["bush_pts"],
      "params": {
        "mode": "normal_up",
        "upright": true,
        "random_yaw": [0, 360],
        "scale_min": 0.6,
        "scale_max": 1.3,
        "seed": "=seed + 17"
      }
    },
    "bush": { "type": "topotopo/nature/bush", "params": { "seed": 4 } },
    "bushes_geo": { "type": "copy_to_points", "in": ["bush", "bush_xf"], "params": { "pack": true } },
    "none": { "type": "points", "params": { "positions": [] } },
    "bushes_on": { "type": "switch", "in": ["none", "bushes_geo"], "params": { "index": "=bushes ? 1 : 0" } },
    "all": { "type": "merge", "in": ["trees", "bushes_on"] },
    "out": {
      "type": "attrib_delete",
      "in": ["all"],
      "params": { "names": "mask sourceprim N up orient pscale copynum variant", "class": "point" }
    }
  },
  "output": "out",
  "outputs": { "forest_patch": { "node": "out", "label": "Forest", "kind": "instances", "tags": ["forest", "trees", "conifer", "vegetation", "scatter", "low-poly"] } },
  "meta": {
    "pivot": "surface",
    "inputs": ["surface"],
    "thumbnail_render": { "elevation": 30 }
  }
}
