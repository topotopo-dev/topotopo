{
  "version": 1,
  "description": "Street lamp: a tapered pole on a flared base with 1–4 curved arms carrying shades and glowing glass (arms 0 = a lantern on top of the pole). The first arm points along +X. Pivot at the centre of the base. Pieces: lamp_pole, lamp_arms, lamp_heads (metal_dark), lamp_glass (lamp_glass, emissive). Every piece is closed.",
  "params": {
    "height": { "type": "float", "default": 4.5, "min": 1.5, "max": 12, "desc": "height of the lamp heads (m)" },
    "arm_length": { "type": "float", "default": 1, "min": 0.2, "max": 4, "desc": "horizontal reach of each arm (m)" },
    "arms": { "type": "int", "default": 1, "min": 0, "max": 4, "desc": "number of arms (0 = lantern on top)" },
    "pole_radius": {
      "type": "float",
      "default": 0.07,
      "min": 0.03,
      "max": 0.3,
      "desc": "pole radius at the base (m)"
    },
    "lamp_size": { "type": "float", "default": 0.4, "min": 0.15, "max": 1.2, "desc": "shade diameter (m)" }
  },
  "vars": { "height": 4.5, "arm_length": 1, "arms": 1, "pole_radius": 0.07, "lamp_size": 0.4 },
  "nodes": {
    "base": {
      "type": "tube",
      "params": {
        "radius": "=pole_radius * 2.3",
        "radius_top": "=pole_radius * 1.3",
        "height": 0.45,
        "center": [0, 0.225, 0],
        "cols": 12
      }
    },
    "pole": {
      "type": "tube",
      "params": {
        "radius": "=pole_radius",
        "radius_top": "=pole_radius * 0.6",
        "height": "=height - (arms > 0 ? 0.2 : 0.1)",
        "center": [0, "=(height - (arms > 0 ? 0.2 : 0.1)) / 2", 0],
        "cols": 12
      }
    },
    "pole_geo": { "type": "merge", "in": ["base", "pole"] },
    "pole_name": {
      "type": "attrib_create",
      "in": ["pole_geo"],
      "params": { "name": "name", "class": "prim", "value": "lamp_pole" }
    },
    "none": { "type": "points", "params": { "positions": [] } },
    "arm_path": {
      "type": "wrangle",
      "in": ["none"],
      "note": "one arm leaving the pole 0.6 m below the top, curving up and out to the head",
      "params": {
        "run_over": "detail",
        "code": "const H = height, L = arm_length, n = 10, pts = [];\nfor (let i = 0; i <= n; i++) { const t = i / n; pts.push(addpoint(0, [L * (1 - Math.cos(t * PI / 2)) * 0 + L * Math.sin(t * PI / 2) * 0.15 + L * 0.85 * t, H - 0.6 + 0.6 * Math.sin(t * PI / 2) + 0.12 * Math.sin(t * PI), 0])); }\naddprim(0, 'polyline', pts);"
      }
    },
    "arm": {
      "type": "sweep",
      "in": ["arm_path"],
      "params": { "radius": "=Math.max(0.025, pole_radius * 0.45)", "divisions": 8 }
    },
    "arm_name": {
      "type": "attrib_create",
      "in": ["arm"],
      "params": { "name": "name", "class": "prim", "value": "lamp_arms" }
    },
    "shade": {
      "type": "tube",
      "params": {
        "radius": "=lamp_size / 2",
        "radius_top": "=lamp_size * 0.15",
        "height": "=lamp_size * 0.4",
        "center": ["=arm_length", "=height - lamp_size * 0.2 + 0.05", 0],
        "cols": 10
      }
    },
    "shade_name": {
      "type": "attrib_create",
      "in": ["shade"],
      "params": { "name": "name", "class": "prim", "value": "lamp_heads" }
    },
    "glass": {
      "type": "tube",
      "params": {
        "radius": "=lamp_size * 0.36",
        "radius_top": "=lamp_size * 0.42",
        "height": "=lamp_size * 0.22",
        "center": ["=arm_length", "=height - lamp_size * 0.4 - lamp_size * 0.11 + 0.06", 0],
        "cols": 10
      }
    },
    "glass_name": {
      "type": "attrib_create",
      "in": ["glass"],
      "params": { "name": "name", "class": "prim", "value": "lamp_glass" }
    },
    "glass_mat": {
      "type": "material",
      "in": ["glass_name"],
      "params": { "name": "lamp_glass", "base_color": "#fff1c8", "emissive": [1.6, 1.35, 0.85], "roughness": 0.1 }
    },
    "one_arm": { "type": "merge", "in": ["arm_name", "shade_name", "glass_mat"] },
    "arm_set": {
      "type": "copy_xform",
      "in": ["one_arm"],
      "params": {
        "count": "=Math.max(1, arms)",
        "translate": [0, 0, 0],
        "rotate": [0, "=360 / Math.max(1, arms)", 0],
        "copy_attrib": ""
      }
    },
    "lantern_cap": {
      "type": "tube",
      "params": {
        "radius": "=lamp_size * 0.45",
        "radius_top": 0.02,
        "height": "=lamp_size * 0.35",
        "center": [0, "=height + lamp_size * 0.6 + lamp_size * 0.175", 0],
        "cols": 4
      }
    },
    "lantern_cap_name": {
      "type": "attrib_create",
      "in": ["lantern_cap"],
      "params": { "name": "name", "class": "prim", "value": "lamp_heads" }
    },
    "lantern_glass": {
      "type": "box",
      "params": {
        "size": ["=lamp_size * 0.5", "=lamp_size * 0.65", "=lamp_size * 0.5"],
        "center": [0, "=height + lamp_size * 0.6 / 2 - 0.05", 0]
      }
    },
    "lantern_glass_name": {
      "type": "attrib_create",
      "in": ["lantern_glass"],
      "params": { "name": "name", "class": "prim", "value": "lamp_glass" }
    },
    "lantern_glass_mat": {
      "type": "material",
      "in": ["lantern_glass_name"],
      "params": { "name": "lamp_glass", "base_color": "#fff1c8", "emissive": [1.6, 1.35, 0.85], "roughness": 0.1 }
    },
    "lantern_rot": { "type": "transform", "in": ["lantern_cap_name"], "params": { "rotate": [0, 45, 0] } },
    "lantern": { "type": "merge", "in": ["lantern_rot", "lantern_glass_mat"] },
    "heads": { "type": "switch", "in": ["lantern", "arm_set"], "params": { "index": "=arms > 0 ? 1 : 0" } },
    "all": { "type": "merge", "in": ["pole_name", "heads"] },
    "metal": {
      "type": "material",
      "in": ["all"],
      "params": {
        "name": "metal_dark",
        "group": "@name!=lamp_glass",
        "base_color": "#2f3338",
        "metallic": 0.7,
        "roughness": 0.5
      }
    },
    "paint": {
      "type": "wrangle",
      "in": ["metal"],
      "params": {
        "run_over": "prims",
        "code": "const m = JSON.parse(detail(0, 'materials') || '{}')[s@material]; if (m) @Cd = m.baseColor;"
      }
    },
    "out": { "type": "attrib_delete", "in": ["paint"], "params": { "groups": "*" } }
  },
  "output": "out",
  "outputs": { "lamp_post": { "node": "out", "label": "Lamp post" } },
  "meta": {
    "watertight": true,
    "thumbnail_render": { "azimuth": 20, "elevation": 15 }
  }
}
