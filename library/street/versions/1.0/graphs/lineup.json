{
  "description": "TopoTopo's street package, its 7 outputs side by side at their defaults. The package's default output and its preview, from bench to sign_post along +X, 1 m apart.",
  "nodes": {
    "bench": {"type":"topotopo/street/bench"},
    "bench_at": {"type":"transform","in":["bench"],"params":{"translate":[0.9,0,0]}},
    "bollard": {"type":"topotopo/street/bollard"},
    "bollard_at": {"type":"transform","in":["bollard"],"params":{"translate":[2.925,0,0]}},
    "cable": {"type":"topotopo/street/cable"},
    "cable_at": {"type":"transform","in":["cable"],"params":{"translate":[4.155,0,0]}},
    "fence": {"type":"topotopo/street/fence"},
    "fence_at": {"type":"transform","in":["fence"],"params":{"translate":[15.304,0,0]}},
    "lamp_post": {"type":"topotopo/street/lamp_post"},
    "lamp_post_at": {"type":"transform","in":["lamp_post"],"params":{"translate":[22.51,0,0]}},
    "road_strip": {"type":"topotopo/street/road_strip"},
    "road_strip_at": {"type":"transform","in":["road_strip"],"params":{"translate":[36.809,0,0]}},
    "sign_post": {"type":"topotopo/street/sign_post"},
    "sign_post_at": {"type":"transform","in":["sign_post"],"params":{"translate":[50.358,0,0]}},
    "lineup": {"type":"merge","in":["bench_at","bollard_at","cable_at","fence_at","lamp_post_at","road_strip_at","sign_post_at"]}
  },
  "output": "lineup",
  "outputs": {"lineup":{"node":"lineup","label":"Street line-up","kind":"mesh","tags":["lineup","street"]}}
}
