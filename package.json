{
  "name": "topotopo",
  "version": "0.1.0",
  "description": "An open-source procedural geometry engine: node graphs in JSON, cooked headless and deterministic, exported to Unreal, Blender and Houdini. Built for LLM agents through MCP, and for people through the CLI.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./node": {
      "types": "./dist/host/node.d.ts",
      "default": "./dist/host/node.js"
    }
  },
  "bin": {
    "topotopo": "dist/cli.js",
    "topo": "dist/cli.js"
  },
  "files": [
    "dist",
    "shelf/*.json",
    "assets/fonts",
    "kernels/pkg",
    "kernels/pkg-simd",
    "!kernels/README.md",
    "!kernels/LICENSE",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "prepack": "npm run build",
    "pack:test": "node scripts/pack-test.ts",
    "mcp": "node src/mcp/server.ts",
    "preview": "node scripts/preview.ts --examples",
    "cook": "node src/cli.ts",
    "test": "node test/smoke.ts && node test/golden.ts && node test/property.ts && node test/fuzz.ts && node test/docs.ts && node test/portability.ts && node test/examples.ts && node scripts/gen-notice.ts --check && node test/io.ts && node test/import.ts && node test/interop.ts && node test/mcp.ts && node test/engine.ts && node test/viewer.ts && node test/topology.ts && node test/deform.ts && node test/cloth.ts && node test/arrays.ts && node test/bugs.ts && node test/uv.ts && node test/polyedit.ts && node test/bevel.ts && node test/measure.ts && node test/render.ts && node test/packed.ts && node test/heightfield.ts && node test/remesh.ts && node test/pcg.ts && node test/scatterkernel.ts && node test/splines.ts && node test/shelf.ts && node test/textures.ts && node test/pool.ts && node test/kernelsloader.ts && node test/kernels.ts && node test/sdfgrid.ts && node test/remeshquad.ts && node test/erosionkernel.ts && node test/erosionsimd.ts && node test/particles.ts && node test/rbd.ts && node test/limits.ts",
    "test:limits": "node test/limits.ts",
    "kernels:build": "node scripts/kernels-build.ts",
    "test:kernels": "node test/scatterkernel.ts && node test/kernelsloader.ts && node test/kernels.ts && node test/sdfgrid.ts && node test/remeshquad.ts && node test/erosionkernel.ts && node test/erosionsimd.ts",
    "test:remeshquad": "node test/remeshquad.ts",
    "test:rbd": "node test/rbd.ts",
    "test:erosionkernel": "node test/erosionkernel.ts",
    "test:pool": "node test/pool.ts --golden",
    "test:particles": "node test/particles.ts",
    "test:splines": "node test/splines.ts",
    "test:uv": "node test/uv.ts",
    "test:render": "node test/render.ts",
    "test:remesh": "node test/remesh.ts",
    "test:pcg": "node test/pcg.ts",
    "test:cloth": "node test/cloth.ts",
    "test:shelf": "node test/shelf.ts",
    "test:textures": "node test/textures.ts",
    "test:smoke": "node test/smoke.ts",
    "test:golden": "node test/golden.ts",
    "test:update": "node test/golden.ts --update",
    "test:property": "node test/property.ts && node test/fuzz.ts",
    "test:docs": "node test/docs.ts",
    "test:portability": "node test/portability.ts",
    "test:examples": "node test/examples.ts",
    "test:interop": "node test/interop.ts",
    "test:viewer": "node test/viewer.ts",
    "showcase": "node test/showcase.ts",
    "export:demo": "node scripts/export-demo.ts",
    "demo:footage": "node scripts/demo-footage.ts",
    "bench": "node bench/bench.ts",
    "docs": "node scripts/gen-docs.ts",
    "site": "node scripts/gen-site.ts",
    "site:check": "node scripts/check-site.ts",
    "shelf": "node scripts/gen-shelf.ts",
    "typecheck": "tsc --noEmit",
    "notice": "node scripts/gen-notice.ts",
    "notice:check": "node scripts/gen-notice.ts --check"
  },
  "keywords": [
    "procedural",
    "geometry",
    "houdini",
    "pcg",
    "unreal",
    "blender",
    "gltf",
    "usd",
    "mcp",
    "node-graph",
    "terrain",
    "instancing"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "d3-delaunay": "^6.0.4",
    "earcut": "^3.2.4",
    "manifold-3d": "^3.5.4",
    "meshoptimizer": "^1.3.0",
    "opentype.js": "^2.0.0",
    "simplex-noise": "^4.0.3",
    "three": "^0.186.1",
    "xatlas-wasm": "0.1.3"
  },
  "devDependencies": {
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "marked": "^18.0.14",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "homepage": "https://topotopo.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/topotopo-dev/topotopo.git"
  },
  "bugs": {
    "url": "https://github.com/topotopo-dev/topotopo/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/faxlab"
  },
  "author": "faxcorp <hello@topotopo.dev>"
}
