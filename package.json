{
  "name": "polyforge",
  "version": "0.1.0",
  "description": "A procedural geometry engine: Houdini-style node graphs, headless, deterministic, exports to Unreal, Blender and Houdini",
  "main": "src/index.ts",
  "scripts": {
    "mcp": "node src/mcp/server.ts",
    "preview": "node scripts/preview.ts --examples",
    "cook": "node src/cli.ts",
    "test": "node test/smoke.ts && node test/golden.ts && node test/property.ts && node test/fuzz.ts && node test/docs.ts && node scripts/gen-notice.ts --check && node test/io.ts && node test/interop.ts && node test/mcp.ts && node test/engine.ts && node test/topology.ts && node test/deform.ts && node test/arrays.ts && node test/bugs.ts && node test/uv.ts && node test/polyedit.ts && node test/bevel.ts && node test/measure.ts && node test/render.ts && node test/packed.ts && node test/heightfield.ts && node test/remesh.ts && node test/pcg.ts",
    "test:uv": "node test/uv.ts",
    "test:render": "node test/render.ts",
    "test:remesh": "node test/remesh.ts",
    "test:pcg": "node test/pcg.ts",
    "test:smoke": "node test/smoke.ts",
    "test:golden": "node test/golden.ts",
    "test:update": "node test/golden.ts --update",
    "test:property": "node test/property.ts && node test/fuzz.ts",
    "test:docs": "node test/docs.ts",
    "test:interop": "node test/interop.ts",
    "showcase": "node test/showcase.ts",
    "export:demo": "node scripts/export-demo.ts",
    "bench": "node bench/bench.ts",
    "docs": "node scripts/gen-docs.ts",
    "typecheck": "tsc --noEmit",
    "notice": "node scripts/gen-notice.ts",
    "notice:check": "node scripts/gen-notice.ts --check"
  },
  "keywords": [
    "procedural",
    "geometry",
    "mcp",
    "houdini",
    "sop",
    "llm"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "d3-delaunay": "^6.0.4",
    "earcut": "^3.2.4",
    "manifold-3d": "^3.5.4",
    "meshoptimizer": "^1.3.0",
    "opentype.js": "^2.0.0",
    "simplex-noise": "^4.0.3",
    "three": "^0.186.1",
    "xatlas-wasm": "0.1.3"
  },
  "devDependencies": {
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
