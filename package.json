{
  "name": "polyforge",
  "version": "0.1.0",
  "description": "LLM-native procedural geometry engine: Houdini-SOP-style node graphs, headless core, MCP server",
  "main": "src/index.ts",
  "scripts": {
    "mcp": "node src/mcp/server.ts",
    "preview": "node scripts/preview.ts --examples",
    "cook": "node src/cli.ts",
    "test": "node test/smoke.ts && node test/io.ts && node test/mcp.ts && node test/topology.ts",
    "test:smoke": "node test/smoke.ts",
    "showcase": "node test/showcase.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "procedural",
    "geometry",
    "mcp",
    "houdini",
    "sop",
    "llm"
  ],
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "d3-delaunay": "^6.0.4",
    "earcut": "^3.2.4",
    "manifold-3d": "^3.5.4",
    "meshoptimizer": "^1.3.0",
    "opentype.js": "^2.0.0",
    "simplex-noise": "^4.0.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
