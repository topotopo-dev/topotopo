        }
       },
       "output": "village",
       "outputs": {
        "village": {
         "node": "village",
         "label": "Village",
         "kind": "scene",
         "tags": [
          "village",
          "guides",
          "level-design"
         ]
        }
       }
      }
     }
    }
   ]
  },
  {
   "text": "The guided_town example graph: it reads inputs/markers.json and builds from TopoTopo's own packages."
  }
 ]
}