         "type": "topotopo/nature/tree_lowpoly",
         "params": {
          "style": "round",
          "height": 9,
          "canopy_radius": 3.2,
          "seed": 11
         }
        },
        "kind_bench": {
         "type": "attrib_create",
         "in": [
          "props_bench"
         ],
         "params": {
          "name": "kind",
          "class": "prim",
          "value": "bench"
         }
        },
        "kind_lamp": {
         "type": "attrib_create",
         "in": [
          "props_lamp"
         ],
         "params": {
          "name": "kind",
          "class": "prim",
          "value": "lamp"
         }
        },
        "kind_tree": {
         "type": "attrib_create",
         "in": [
          "props_tree"
         ],
         "params": {
          "name": "kind",
          "class": "prim",
          "value": "tree"
         }
        },
        "props_kit": {
         "type": "merge",
         "in": [
          "kind_bench",
          "kind_lamp",
          "kind_tree"
