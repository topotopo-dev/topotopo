        },
        "site_kind": {
         "type": "wrangle",
         "in": [
          "sites"
         ],
         "params": {
          "run_over": "points",
          "code": "const k = @name.split('_')[0]; s@kind = k === 'bench' || k === 'lamp' ? k : 'tree'; f@size = s@kind === 'tree' ? @pscale / 5 : 1; @pscale = 1;"
         }
        },
        "props_bench": {
         "type": "topotopo/street/bench",
         "params": {}
        },
        "props_lamp": {
         "type": "topotopo/street/lamp_post",
         "params": {
          "arms": 0,
          "height": 3.2
         }
        },
