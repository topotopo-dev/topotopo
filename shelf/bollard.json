{
  "version": 1,
  "description": "Street bollard: a round post with a domed top or a square post with a pyramid cap, an optional reflective band and a base ring. Pivot at the centre of the base. Pieces: bollard_body (metal_dark), bollard_band (reflective). Every piece is closed.",
  "params": {
    "height": { "type": "float", "default": 0.9, "min": 0.3, "max": 2, "desc": "height (m)" },
    "radius": {
      "type": "float",
      "default": 0.1,
      "min": 0.03,
      "max": 0.4,
      "desc": "post radius (half width for square) (m)"
    },
    "style": { "type": "enum", "default": "round", "options": ["round", "square"], "desc": "post section" },
    "band": { "type": "bool", "default": true, "desc": "reflective band near the top" }
  },
  "vars": { "height": 0.9, "radius": 0.1, "style": "round", "band": true },
  "nodes": {
    "post_round": {
      "type": "tube",
      "params": {
        "radius": "=radius",
        "height": "=height - radius * 0.6",
        "center": [0, "=(height - radius * 0.6) / 2", 0],
        "cols": 20
      }
    },
    "dome": {
      "type": "sphere",
      "params": {
        "type": "uv",
        "radius": "=radius",
        "rows": 8,
        "cols": 20,
        "scale": [1, 0.6, 1],
        "center": [0, "=height - radius * 0.6", 0]
      }
    },
    "ring": {
      "type": "tube",
      "params": {
        "radius": "=radius * 1.25",
        "radius_top": "=radius * 1.1",
        "height": "=radius * 0.5",
        "center": [0, "=radius * 0.25", 0],
        "cols": 20
      }
    },
    "round": { "type": "merge", "in": ["post_round", "dome", "ring"] },
    "post_square": {
      "type": "box",
      "params": {
        "size": ["=radius * 2", "=height - radius * 0.6", "=radius * 2"],
        "center": [0, "=(height - radius * 0.6) / 2", 0]
      }
    },
    "cap": {
      "type": "tube",
      "params": {
        "radius": "=radius * Math.SQRT2 * 1.1",
        "radius_top": "=radius * 0.3",
        "height": "=radius * 0.6",
        "center": [0, "=height - radius * 0.3", 0],
        "cols": 4
      }
    },
    "cap_rot": { "type": "transform", "in": ["cap"], "params": { "rotate": [0, 45, 0] } },
    "plinth": {
      "type": "box",
      "params": { "size": ["=radius * 2.5", "=radius * 0.5", "=radius * 2.5"], "center": [0, "=radius * 0.25", 0] }
    },
    "square": { "type": "merge", "in": ["post_square", "cap_rot", "plinth"] },
    "body": {
      "type": "switch",
      "in": ["round", "square"],
      "params": { "index": "=style == 'square' ? 1 : 0" }
    },
    "body_name": {
      "type": "attrib_create",
      "in": ["body"],
      "params": { "name": "name", "class": "prim", "value": "bollard_body" }
    },
    "body_mat": {
      "type": "material",
      "in": ["body_name"],
      "params": { "name": "metal_dark", "base_color": "#2f3338", "metallic": 0.7, "roughness": 0.5 }
    },
    "band_round": {
      "type": "tube",
      "params": {
        "radius": "=radius + 0.004",
        "height": "=Math.min(0.08, height * 0.08)",
        "center": [0, "=height * 0.78", 0],
        "cols": 20
      }
    },
    "band_square": {
      "type": "box",
      "params": {
        "size": ["=radius * 2 + 0.008", "=Math.min(0.08, height * 0.08)", "=radius * 2 + 0.008"],
        "center": [0, "=height * 0.78", 0]
      }
    },
    "band_geo": {
      "type": "switch",
      "in": ["band_round", "band_square"],
      "params": { "index": "=style == 'square' ? 1 : 0" }
    },
    "band_name": {
      "type": "attrib_create",
      "in": ["band_geo"],
      "params": { "name": "name", "class": "prim", "value": "bollard_band" }
    },
    "band_mat": {
      "type": "material",
      "in": ["band_name"],
      "params": { "name": "reflective", "base_color": "#e8c33a", "roughness": 0.3, "emissive": [0.15, 0.12, 0.02] }
    },
    "none": { "type": "points", "params": { "positions": [] } },
    "band_on": { "type": "switch", "in": ["none", "band_mat"], "params": { "index": "=band ? 1 : 0" } },
    "all": { "type": "merge", "in": ["body_mat", "band_on"] },
    "paint": {
      "type": "wrangle",
      "in": ["all"],
      "params": {
        "run_over": "prims",
        "code": "const m = JSON.parse(detail(0, 'materials') || '{}')[s@material]; if (m) @Cd = m.baseColor;"
      }
    },
    "out": { "type": "normal", "in": ["paint"], "params": { "cusp_angle": 45 } }
  },
  "output": "out",
  "meta": { "shelf_group": "props", "watertight": true, "thumbnail_render": { "elevation": 20 } }
}
