{
  "version": 1,
  "description": "Spiral staircase: wedge treads turning counter-clockwise (seen from above) around a central column, with an optional helical handrail on posts. Pivot at the foot of the column. Pieces: spiral_treads (wood), spiral_column (metal_dark), spiral_railing (metal_dark). Every piece is closed.",
  "params": {
    "steps": { "type": "int", "default": 16, "min": 2, "max": 60, "desc": "number of treads" },
    "rise": { "type": "float", "default": 0.2, "min": 0.1, "max": 0.3, "desc": "height of one step (m)" },
    "turn": { "type": "float", "default": 22.5, "min": 10, "max": 45, "desc": "rotation per step (degrees)" },
    "radius": { "type": "float", "default": 1.1, "min": 0.5, "max": 4, "desc": "outer radius (m)" },
    "column_radius": { "type": "float", "default": 0.1, "min": 0.03, "max": 0.5, "desc": "column radius (m)" },
    "railing": { "type": "bool", "default": true, "desc": "handrail along the outer edge" }
  },
  "vars": { "steps": 16, "rise": 0.2, "turn": 22.5, "radius": 1.1, "column_radius": 0.1, "railing": true },
  "nodes": {
    "tread_box": {
      "type": "box",
      "params": {
        "size": ["=radius - column_radius * 0.5", 0.05, 1],
        "center": ["=(radius + column_radius * 0.5) / 2", "=rise - 0.025", 0],
        "divisions": [2, 1, 1]
      }
    },
    "wedge": {
      "type": "wrangle",
      "in": ["tread_box"],
      "note": "taper the tread to the step angle: its width grows linearly from the column to the rim",
      "params": {
        "run_over": "points",
        "code": "const a = radians(turn) * 1.08, w = (x) => 2 * Math.max(0.03, x) * Math.tan(a / 2);\n@P.z *= w(@P.x);"
      }
    },
    "treads": {
      "type": "copy_xform",
      "in": ["wedge"],
      "params": { "count": "=steps", "translate": [0, "=rise", 0], "rotate": [0, "=turn", 0] }
    },
    "treads_name": {
      "type": "attrib_create",
      "in": ["treads"],
      "params": { "name": "name", "class": "prim", "value": "spiral_treads" }
    },
    "treads_mat": {
      "type": "material",
      "in": ["treads_name"],
      "params": { "name": "wood", "base_color": "#9a7148", "roughness": 0.8 }
    },
    "column": {
      "type": "tube",
      "params": {
        "radius": "=column_radius",
        "height": "=steps * rise + (railing ? 0.95 : 0.1)",
        "center": [0, "=(steps * rise + (railing ? 0.95 : 0.1)) / 2", 0],
        "cols": 16
      }
    },
    "column_name": {
      "type": "attrib_create",
      "in": ["column"],
      "params": { "name": "name", "class": "prim", "value": "spiral_column" }
    },
    "column_mat": {
      "type": "material",
      "in": ["column_name"],
      "params": { "name": "metal_dark", "base_color": "#3a3d42", "metallic": 0.8, "roughness": 0.45 }
    },
    "rail_path": {
      "type": "spiral",
      "params": {
        "radius": "=radius - 0.05",
        "height": "=(steps - 1) * rise",
        "turns": "=(steps - 1) * turn / 360",
        "points_per_turn": 48,
        "clockwise": true,
        "center": [0, "=rise + 0.9", 0]
      }
    },
    "rail": { "type": "sweep", "in": ["rail_path"], "params": { "radius": 0.025, "divisions": 10 } },
    "post": {
      "type": "tube",
      "params": { "radius": 0.018, "height": 0.9, "center": [0, -0.45, 0], "cols": 8 }
    },
    "post_pts": {
      "type": "resample",
      "in": ["rail_path"],
      "params": { "mode": "count", "count": "=Math.max(2, Math.ceil(steps / 2))" }
    },
    "posts": { "type": "copy_to_points", "in": ["post", "post_pts"] },
    "railing_geo": { "type": "merge", "in": ["rail", "posts"] },
    "railing_name": {
      "type": "attrib_create",
      "in": ["railing_geo"],
      "params": { "name": "name", "class": "prim", "value": "spiral_railing" }
    },
    "railing_mat": {
      "type": "material",
      "in": ["railing_name"],
      "params": { "name": "metal_dark", "base_color": "#3a3d42", "metallic": 0.8, "roughness": 0.45 }
    },
    "none": { "type": "points", "params": { "positions": [] } },
    "railing_on": { "type": "switch", "in": ["none", "railing_mat"], "params": { "index": "=railing ? 1 : 0" } },
    "all": { "type": "merge", "in": ["treads_mat", "column_mat", "railing_on"] },
    "paint": {
      "type": "wrangle",
      "in": ["all"],
      "params": {
        "run_over": "prims",
        "code": "const m = JSON.parse(detail(0, 'materials') || '{}')[s@material]; if (!m) return; const k = s@name === 'spiral_treads' ? 0.85 + 0.25 * rand(i@copynum, 5) : 1; @Cd = mul(m.baseColor, k);"
      }
    },
    "out": {
      "type": "attrib_delete",
      "in": ["paint"],
      "params": { "names": "copynum curveu", "groups": "*" }
    }
  },
  "output": "out",
  "meta": { "shelf_group": "architecture", "watertight": true, "thumbnail_render": { "elevation": 20 } }
}
